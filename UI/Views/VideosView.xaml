<UserControl x:Class="HTPC.UI.Views.VideosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F0F0F" Foreground="White">

    <UserControl.Resources>
        <Style x:Key="NavPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#B3B3B3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/> 
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#333333"/>
                            </Trigger>
                            
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#444444"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="White"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavPillActiveStyle" TargetType="Button" BasedOn="{StaticResource NavPillStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Focusable" Value="False"/> 
        </Style>

        <Style x:Key="StandardFocusStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderThickness="2" BorderBrush="White" CornerRadius="8" Margin="-2">
                            <Border.Effect>
                                <DropShadowEffect Color="White" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,40,0,0" FocusManager.IsFocusScope="True" 
          KeyboardNavigation.DirectionalNavigation="Continue" 
          KeyboardNavigation.TabNavigation="Cycle">
        
        <Grid x:Name="MasterGroupsGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="TopNavPanel" Grid.Row="0" Orientation="Horizontal" Margin="40,0,0,30" KeyboardNavigation.DirectionalNavigation="Continue" PreviewKeyDown="TopNavPanel_PreviewKeyDown">                
                <Button Content="Home" Click="Home_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Guide" Click="Guide_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Multiview" Click="NavMultiview_Click" Style="{StaticResource NavPillStyle}"/>
				<Button Content="Movies" Click="Movies_Click" Style="{StaticResource NavPillStyle}"/>
				<Button Content="Collections" Click="Collections_Click" Style="{StaticResource NavPillStyle}"/>
				<Button Content="Recordings" Click="Recordings_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Shows" Click="Shows_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Videos" Style="{StaticResource NavPillActiveStyle}"/>
                <Button Content="Settings" Click="Settings_Click" Style="{StaticResource NavPillStyle}"/>
            </StackPanel>

            <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="0,0,0,60" KeyboardNavigation.DirectionalNavigation="Continue">
                    
                    <StackPanel Orientation="Horizontal" Margin="40,0,0,20">
                        <TextBlock Text="Video Folders" FontSize="24" FontWeight="Bold" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        
                        <Button x:Name="GroupSortBtn" Content="Alphabetical ▼" Width="180" Height="40" Background="#1A1A1A" Foreground="White" BorderThickness="1" BorderBrush="#333333" FontSize="16" FontWeight="SemiBold" Margin="0,0,10,0" Click="GroupSortBtn_Click" PreviewKeyDown="FilterBtn_PreviewKeyDown" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>

                        <Button x:Name="GroupOrderBtn" Content="Forward ▼" Width="120" Height="40" Background="#1A1A1A" Foreground="White" BorderThickness="1" BorderBrush="#333333" FontSize="16" FontWeight="SemiBold" Click="GroupOrderBtn_Click" PreviewKeyDown="FilterBtn_PreviewKeyDown" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>

                    <ListBox x:Name="GroupsGrid" ItemsSource="{Binding VideoGroups}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" 
                             KeyboardNavigation.DirectionalNavigation="Continue" PreviewMouseWheel="GroupsGrid_PreviewMouseWheel">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="40,0,0,0" KeyboardNavigation.DirectionalNavigation="Continue"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,20,30"/>
                                <EventSetter Event="MouseLeftButtonUp" Handler="GroupCard_Click"/>
                                <EventSetter Event="PreviewKeyDown" Handler="GroupItem_PreviewKeyDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="FocusRing" Property="BorderBrush" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="240" Height="280" Background="#1E1E1E" CornerRadius="12" Cursor="Hand">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="160"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="📁" FontSize="80" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                                        <Image Grid.Row="0" Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill" ClipToBounds="True">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,240,160" RadiusX="12" RadiusY="12"/>
                                            </Image.Clip>
                                        </Image>
                                        <Border Grid.Row="1" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border x:Name="VideosOverlay" Background="#F20A0A0A" Visibility="Collapsed" Margin="0,-40,0,0" KeyboardNavigation.DirectionalNavigation="Continue">
            <Grid Margin="40" KeyboardNavigation.DirectionalNavigation="Continue">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,40,0,20" KeyboardNavigation.DirectionalNavigation="Continue">
                    <Button x:Name="BackToFoldersBtn" Content="🔙 Back" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="20" FontWeight="Bold" Cursor="Hand" Click="CloseOverlay_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}" PreviewKeyDown="BackToFoldersBtn_PreviewKeyDown" Margin="0,0,20,0"/>
                    <TextBlock x:Name="SelectedGroupName" Text="Folder Name" Foreground="#00A4EF" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,30,0"/>

                    <Button x:Name="VideoSortBtn" Content="Date Added ▼" Width="180" Height="40" Background="#1A1A1A" Foreground="White" BorderThickness="1" BorderBrush="#333333" FontSize="16" FontWeight="SemiBold" Margin="0,0,10,0" Click="VideoSortBtn_Click" PreviewKeyDown="FilterBtn_PreviewKeyDown" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>

                    <Button x:Name="VideoOrderBtn" Content="Forward ▼" Width="120" Height="40" Background="#1A1A1A" Foreground="White" BorderThickness="1" BorderBrush="#333333" FontSize="16" FontWeight="SemiBold" Click="VideoOrderBtn_Click" PreviewKeyDown="FilterBtn_PreviewKeyDown" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </StackPanel>

                <ScrollViewer x:Name="OverlayScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ListBox x:Name="VideosList" ItemsSource="{Binding CurrentVideos}" Background="Transparent" BorderThickness="0" KeyboardNavigation.DirectionalNavigation="Continue"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             PreviewMouseWheel="VideosList_PreviewMouseWheel">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Continue"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,20,30"/>
                                <EventSetter Event="MouseLeftButtonUp" Handler="VideoCard_Click"/>
                                <EventSetter Event="PreviewKeyDown" Handler="VideoItem_PreviewKeyDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="FocusRing" Property="BorderBrush" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="300" Height="220" Background="#1E1E1E" CornerRadius="12" Cursor="Hand">
                                    
                                    <Border.ContextMenu>
                                        <ContextMenu Opened="ContextMenu_Opened">
                                            <MenuItem Header="Mark as Watched" Click="AdminCommand_Click" Tag="watch" FontSize="14" Padding="5"/>
                                            <MenuItem Header="Mark as Unwatched" Click="AdminCommand_Click" Tag="unwatch" FontSize="14" Padding="5"/>
                                            <MenuItem Header="Favorite" Click="AdminCommand_Click" Tag="favorite" FontSize="14" Padding="5"/>
                                            <MenuItem Header="Unfavorite" Click="AdminCommand_Click" Tag="unfavorite" FontSize="14" Padding="5"/>
                                            <Separator/>
                                            <MenuItem Header="Fix Timestamp" Click="AdminCommand_Click" Tag="retimestamp" FontSize="14" Padding="5"/>
                                            <MenuItem Header="Reprocess Video" Click="AdminCommand_Click" Tag="fingerprint" FontSize="14" Padding="5"/>
                                            <MenuItem Header="Refresh Metadata" Click="AdminCommand_Click" Tag="reprocess" FontSize="14" Padding="5"/>
                                            <MenuItem Header="Redetect Commercials" Click="AdminCommand_Click" Tag="recomskip" FontSize="14" Padding="5"/>
                                            <Separator/>
                                            <MenuItem Header="View Media Info" Click="MediaInfo_Click" FontSize="14" Padding="5" FontWeight="SemiBold"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="160"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="▶️" FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                                            <Image Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill" ClipToBounds="True">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,300,160" RadiusX="12" RadiusY="12"/>
                                                </Image.Clip>
                                            </Image>
                                            
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8">
                                                <TextBlock Text="♥" Foreground="#D32F2F" FontSize="20" Margin="0,0,5,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border Background="#00A4EF" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWatched}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="✓" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <Border Grid.Row="1" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                            <TextBlock Text="{Binding CurrentShowTitle}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="ToastNotification" Grid.RowSpan="2" Background="#D800A4EF" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,50" Padding="20,10" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="100">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
        </Border>

        <Border x:Name="MediaInfoModal" Grid.RowSpan="2" Background="#F20A0A0A" Visibility="Collapsed" Padding="40" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="500" MaxWidth="800" Panel.ZIndex="100">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="Media Information" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
                <TextBlock x:Name="MediaInfoTitle" Grid.Row="1" FontSize="18" FontWeight="SemiBold" Foreground="#00A4EF" Margin="0,0,0,15" TextWrapping="Wrap"/>
                <StackPanel x:Name="MediaInfoDetails" Grid.Row="2" Margin="0,0,0,30"/>
                <Button Grid.Row="3" Content="Close" Width="120" Height="40" Background="#333333" Foreground="White" FontWeight="SemiBold" FontSize="16" BorderThickness="0" Cursor="Hand" Click="CloseMediaInfo_Click" HorizontalAlignment="Right" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>
            </Grid>
        </Border>
        
        <!-- FILTER SELECTION OVERLAY -->
        <Border x:Name="FilterOverlay" Grid.RowSpan="2" Background="#F20A0A0A" Visibility="Collapsed" Panel.ZIndex="600">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="FilterOverlayTitle" Text="Select Option" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <ListBox x:Name="FilterSelectionList" Grid.Row="1" MaxHeight="500" MinWidth="350" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="FilterSelectionList_PreviewKeyDown"
                         MouseLeftButtonUp="FilterSelectionList_MouseUp">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="20,15"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="Background" Value="#1A1A1A"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{StaticResource StandardFocusStyle}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="2">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#333333"/>
                                                <Setter Property="Foreground" Value="#00A4EF"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#444444"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter TargetName="bg" Property="BorderBrush" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

    </Grid>
</UserControl>