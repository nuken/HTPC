<UserControl x:Class="HTPC.UI.Views.SportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    
    <UserControl.Resources>
        <!-- Standard Nav Pill Style -->
        <Style x:Key="NavPillStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource NavBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="NavPillActiveStyle" TargetType="Button" BasedOn="{StaticResource NavPillStyle}">
            <Setter Property="Background" Value="{DynamicResource ActiveNavBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ActiveNavTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            
        </Style>

        <!-- Focus Style for Standard Buttons -->
        <Style x:Key="StandardFocusStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderThickness="2" BorderBrush="{DynamicResource PrimaryTextBrush}" CornerRadius="8" Margin="-2">
                            <Border.Effect>
                                <DropShadowEffect Color="White" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,40,0,0" FocusManager.IsFocusScope="True"
          KeyboardNavigation.DirectionalNavigation="Continue"
          KeyboardNavigation.TabNavigation="Cycle">
        
        <Grid x:Name="MasterGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP NAVIGATION -->
            <StackPanel x:Name="TopNavPanel" Grid.Row="0" Orientation="Horizontal" Margin="40,0,0,30" KeyboardNavigation.DirectionalNavigation="Continue" PreviewKeyDown="TopNavPanel_PreviewKeyDown">
                <Button Content="Home" Click="Home_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Guide" Click="Guide_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Multiview" Click="NavMultiview_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Movies" Click="Movies_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Collections" Click="Collections_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Recordings" Click="Recordings_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Shows" Click="Shows_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Sports" Style="{StaticResource NavPillActiveStyle}"/>
                <Button Content="Videos" Click="Videos_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Settings" Click="Settings_Click" Style="{StaticResource NavPillStyle}"/>
                <Button x:Name="ThemeToggleBtn" FontFamily="Segoe MDL2 Assets" Content="&#xE708;" FontSize="20" Click="ThemeToggleBtn_Click" Style="{StaticResource NavPillStyle}"/>
            </StackPanel>

            <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="MainScroll_ScrollChanged" Focusable="False">
                <StackPanel Margin="0,0,0,60" KeyboardNavigation.DirectionalNavigation="Continue">
                    
                    <!-- FILTER BAR & SEARCH -->
                    <Grid Margin="40,0,40,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <!-- Add Sport Dropdown Trigger -->
                            <!-- Add Sport Dropdown Trigger -->
                            <Button x:Name="AddSportBtn" Height="40" Padding="15,0" Margin="0,0,20,0"
                                    Click="AddSportBtn_Click" PreviewKeyDown="AddSportBtn_PreviewKeyDown" 
                                    Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBg" Background="{DynamicResource PanelBackgroundBrush}" 
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                                CornerRadius="20" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="+ Add Sport" Foreground="{DynamicResource PrimaryTextBrush}" 
                                                       FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!-- Hover State -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBg" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                            </Trigger>
                                            
                                            <!-- Remote Control Focus State -->
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="BtnBg" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                <Setter TargetName="BtnBg" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Active Filter Pills -->
                            <ItemsControl x:Name="ActiveFiltersList" ItemsSource="{Binding ActiveGenreFilters}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- FIX 1: Removed the mismatched StandardFocusStyle and set it to {x:Null} -->
                                        <Button Click="RemoveFilterBtn_Click" PreviewKeyDown="FilterPill_PreviewKeyDown" Tag="{Binding}" Margin="0,0,10,0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <!-- FIX 2: Matched the Movies page GenrePillStyle colors and added the border attributes -->
                                                    <Border x:Name="PillBg" Background="{DynamicResource ActiveNavBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="15,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <!-- FIX 3: Bound the text color to the Button's foreground so it updates correctly during triggers -->
                                                            <TextBlock Text="{Binding}" Foreground="{TemplateBinding Foreground}" FontWeight="Bold" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="{TemplateBinding Foreground}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <!-- Default text color -->
                                                        <Trigger Property="IsMouseOver" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource ActiveNavTextBrush}"/>
                                                        </Trigger>
                                                        
                                                        <!-- Hover State (Matches Movies Genre Pills) -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource ActiveNavTextBrush}"/>
                                                            <Setter TargetName="PillBg" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                        </Trigger>
                                                        
                                                        <!-- Remote Control Focus State (Matches Movies Genre Pills) -->
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource ActiveNavTextBrush}"/>
                                                            <Setter TargetName="PillBg" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                            <Setter TargetName="PillBg" Property="BorderThickness" Value="2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Search -->
                        <Border Grid.Column="1" Width="250" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="8" Padding="15,8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                            <Grid>
                                <TextBox x:Name="SearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="SearchBox_PreviewKeyDown" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" FontSize="16" CaretBrush="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Search events..." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="16" IsHitTestVisible="False" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Airing Now GRID -->
                    <TextBlock Text="Airing Now" FontSize="24" FontWeight="Bold" Margin="40,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LiveEvents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    
                    <ListBox x:Name="LiveEventsGrid" ItemsSource="{Binding LiveEvents}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             KeyboardNavigation.DirectionalNavigation="Continue"
							 PreviewMouseWheel="SportsGrid_PreviewMouseWheel">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="40,0,0,0" KeyboardNavigation.DirectionalNavigation="Continue"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,20,30"/>
                                <EventSetter Event="MouseLeftButtonUp" Handler="EventCard_Click"/>
                                <EventSetter Event="PreviewKeyDown" Handler="ListBoxItem_PreviewKeyDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                       <ListBox.ItemTemplate>
    <DataTemplate>
        <Border Width="300" Height="250" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Cursor="Hand" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="168"/> <!-- 16:9 Image Area -->
                    <RowDefinition Height="*"/>   <!-- Text Area -->
                </Grid.RowDefinitions>
                
                <!-- THE IMAGE (Top) -->
                <Image Grid.Row="0" Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill" />
                
                <!-- THE TEXT AND SCORE (Bottom) -->
                <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ChannelName}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <!-- THE LIVE SCORE BLOCK -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="15,0,0,0">
                            <!-- This style hides the entire score block if no score is provided -->
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LiveScore}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LiveScore}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            
                            <TextBlock Text="{Binding LiveScore}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding GamePeriod}" Foreground="#E63946" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>
</ListBox.ItemTemplate>
                    
					
					</ListBox>

                    <!-- UPCOMING GRID -->
                    <TextBlock Text="Upcoming" FontSize="24" FontWeight="Bold" Margin="40,10,0,10" Foreground="{DynamicResource PrimaryTextBrush}">
                         <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpcomingEvents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListBox x:Name="UpcomingEventsGrid" ItemsSource="{Binding UpcomingEvents}" Background="Transparent" BorderThickness="0"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
         KeyboardNavigation.DirectionalNavigation="Continue"
		 PreviewMouseWheel="SportsGrid_PreviewMouseWheel">
    
    <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" Margin="40,0,0,0" KeyboardNavigation.DirectionalNavigation="Continue"/>
        </ItemsPanelTemplate>
    </ListBox.ItemsPanel>
    
    <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,20,30"/>
            <EventSetter Event="MouseLeftButtonUp" Handler="EventCard_Click"/>
            <EventSetter Event="PreviewKeyDown" Handler="ListBoxItem_PreviewKeyDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ListBox.ItemContainerStyle>
    
    <ListBox.ItemTemplate>
       <DataTemplate>
    <!-- Increased height to 250 and added ClipToBounds to keep corners rounded -->
    <Border Width="300" Height="250" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Cursor="Hand" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="168"/> <!-- 16:9 Image Area -->
                <RowDefinition Height="*"/>   <!-- Text Area -->
            </Grid.RowDefinitions>
            
            <!-- THE IMAGE (Top) -->
            <Image Grid.Row="0" Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill" />
            
            <!-- THE TEXT (Bottom) -->
            <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="12,8">
                <StackPanel>
                    <!-- TextWrapping="Wrap" ensures the team names don't get cut off -->
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ChannelName}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</DataTemplate>
    </ListBox.ItemTemplate>
</ListBox>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- EVENT DETAILS MODAL OVERLAY -->
        <Border x:Name="EventModalOverlay" Grid.RowSpan="2" Background="{DynamicResource OverlayBackgroundBrush}" Visibility="Collapsed" VerticalAlignment="Bottom" MinHeight="340" Padding="40" CornerRadius="24,24,0,0" Panel.ZIndex="500">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
            </Border.Effect>
            <Grid KeyboardNavigation.DirectionalNavigation="Cycle">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Width="400" Height="225" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource PanelBackgroundBrush}" Margin="0,0,30,0" VerticalAlignment="Center">
                    <Image x:Name="ModalImage" Stretch="UniformToFill"/>
                </Border>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,30,0">
                    <TextBlock x:Name="ModalTitle" Text="Matchup" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <TextBlock x:Name="ModalNetwork" Text="Network" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ModalTime" Text="Airing Now" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,15"/>
                    <TextBlock x:Name="ModalSummary" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,10"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" VerticalAlignment="Center" KeyboardNavigation.DirectionalNavigation="Cycle" PreviewKeyDown="EventModalButtons_PreviewKeyDown">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>
                    
                    <Button x:Name="TuneInBtn" Content="  Tune In" Width="180" Height="45" Background="{DynamicResource ActiveNavBackgroundBrush}" Foreground="{DynamicResource ActiveNavTextBrush}" FontWeight="Bold" FontSize="16" BorderThickness="0" Margin="0,0,0,15" Cursor="Hand" Click="TuneIn_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>
                    <Button x:Name="RecordBtn" Content="  Record Event" Width="180" Height="45" Background="#A50000" Foreground="White" FontWeight="Bold" FontSize="16" BorderThickness="0" Margin="0,0,0,15" Cursor="Hand" Click="Record_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>
                    <Button x:Name="CloseModalBtn" Content="Close" Width="180" Height="45" Background="{DynamicResource NavBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" BorderThickness="0" Cursor="Hand" Click="CloseModal_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILTER SELECTION OVERLAY -->
        <Border x:Name="FilterOverlay" Grid.RowSpan="2" Background="{DynamicResource OverlayBackgroundBrush}" Visibility="Collapsed" Panel.ZIndex="600">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/> <!-- NEW: Row for the Close Button -->
                </Grid.RowDefinitions>
                
                <TextBlock Text="Select Sport to Add" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                
                <ListBox x:Name="FilterSelectionList" Grid.Row="1" MaxHeight="500" MinWidth="350" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="FilterSelectionList_PreviewKeyDown"
                         MouseLeftButtonUp="FilterSelectionList_MouseUp">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="20,15"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{StaticResource StandardFocusStyle}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="2">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- NEW: Dedicated Close Button -->
                <Button x:Name="CloseFilterBtn" Grid.Row="2" Content="Close" Margin="0,20,0,0" Height="50"
                        Background="{DynamicResource NavBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" 
                        FontSize="18" FontWeight="Bold" BorderThickness="0" Cursor="Hand" 
                        Click="CloseFilterBtn_Click" PreviewKeyDown="CloseFilterBtn_PreviewKeyDown" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
	</Grid>
</UserControl>