                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="200" Height="300" Background="#1E1E1E" CornerRadius="12" Cursor="Hand" ClipToBounds="True">
                                        <Border.Effect><DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/></Border.Effect>
                                        <Grid>
                                            <Image Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill">
                                                <Image.Clip>
                                                     <RectangleGeometry Rect="0,0,200,300" RadiusX="12" RadiusY="12"/>
                                                </Image.Clip>
                                            </Image>
                                            <Border VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="&lt;" HorizontalAlignment="Left" Margin="15,0,0,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollLeft_Click" Tag="{Binding ElementName=RecentMoviesList}"/>
                        <Button Content="&gt;" HorizontalAlignment="Right" Margin="0,0,15,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollRight_Click" Tag="{Binding ElementName=RecentMoviesList}"/>
                    </Grid>
                </StackPanel>

                <StackPanel>
    <TextBlock Text="Local Imports &amp; Virtual Media" FontSize="24" FontWeight="Bold" Margin="40,0,0,10"/>
    
    <TextBlock Text="No local imports or virtual media found." Foreground="#888888" FontSize="16" FontStyle="Italic" Margin="40,0,0,40">
        <TextBlock.Style>
            <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ImportedMedia.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </TextBlock.Style>
    </TextBlock>

    <Grid Margin="0,0,0,60">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ImportedMedia.Count}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <ListBox x:Name="ImportedMediaList" ItemsSource="{Binding ImportedMedia}" Focusable="False" IsTabStop="False" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
				 ScrollViewer.ScrollChanged="HorizontalList_ScrollChanged"
                 PreviewMouseWheel="HorizontalList_PreviewMouseWheel" KeyboardNavigation.DirectionalNavigation="Continue" ScrollViewer.PanningMode="HorizontalOnly">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal" Margin="40,15,40,25"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,20,0"/>
                                    <EventSetter Event="PreviewKeyDown" Handler="ListBoxItem_PreviewKeyDown"/>
                                    <EventSetter Event="MouseLeftButtonUp" Handler="RecordingCard_Click"/>
									<EventSetter Event="UIElement.GotKeyboardFocus" Handler="RecordingCard_GotKeyboardFocus"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="200" Height="300" Background="#1E1E1E" CornerRadius="12" Cursor="Hand" ClipToBounds="True">
                                        <Border.Effect><DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/></Border.Effect>
                                        <Grid>
                                            <Image Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill">
                                                <Image.Clip>
                                                     <RectangleGeometry Rect="0,0,200,300" RadiusX="12" RadiusY="12"/>
                                                </Image.Clip>
                                            </Image>
                                            <Border VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="&lt;" HorizontalAlignment="Left" Margin="15,0,0,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollLeft_Click" Tag="{Binding ElementName=ImportedMediaList}"/>
                        <Button Content="&gt;" HorizontalAlignment="Right" Margin="0,0,15,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollRight_Click" Tag="{Binding ElementName=ImportedMediaList}"/>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border x:Name="ModalOverlay" Grid.RowSpan="2" Background="#F20A0A0A" Visibility="Collapsed" VerticalAlignment="Bottom" Height="300" Padding="40" CornerRadius="24,24,0,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
            </Border.Effect>
            <Grid KeyboardNavigation.DirectionalNavigation="Cycle">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="*"/> <ColumnDefinition Width="Auto"/> 
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="160" Height="220" CornerRadius="12" ClipToBounds="True" Background="#1A1A1A" Margin="0,0,30,0">
                    <Image x:Name="ModalImage" Stretch="UniformToFill">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,160,220" RadiusX="12" RadiusY="12"/>
                        </Image.Clip>
                    </Image>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,30,0">
                    <TextBlock x:Name="ModalTitle" FontSize="28" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <TextBlock x:Name="ModalSubTitle" FontSize="20" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ModalTime" FontSize="16" FontWeight="Bold" Foreground="#00A4EF" Margin="0,0,0,15" Visibility="Collapsed"/>
                    <TextBlock x:Name="ModalSummary" FontSize="15" Foreground="#CCCCCC" TextWrapping="Wrap" LineHeight="22" MaxHeight="100" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" KeyboardNavigation.DirectionalNavigation="Cycle">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.8"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>
                    <Button x:Name="ModalPlayBtn" Content="▶ Play" Width="160" Height="40" Background="White" Foreground="Black" FontWeight="Bold" FontSize="16" BorderThickness="0" Margin="0,0,0,15" Cursor="Hand" Click="ModalPlay_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>
    
    <Button x:Name="CloseModalBtn" Content="Close" Width="160" Height="40" Background="#333333" Foreground="White" FontWeight="SemiBold" FontSize="16" BorderThickness="0" Margin="0,0,0,15" Cursor="Hand" Click="CloseModal_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>
    
    <Button x:Name="DeleteModalBtn" Content="🗑 Delete" Width="160" Height="40" Background="#8B0000" Foreground="White" FontWeight="SemiBold" FontSize="16" BorderThickness="0" Cursor="Hand" Click="DeleteModal_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>