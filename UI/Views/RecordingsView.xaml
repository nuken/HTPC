<UserControl x:Class="HTPC.UI.Views.RecordingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="NavPillStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource NavBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavPillActiveStyle" TargetType="Button" BasedOn="{StaticResource NavPillStyle}">
            <Setter Property="Background" Value="{DynamicResource ActiveNavBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ActiveNavTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,30,0"/>
            <Setter Property="Padding" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style x:Key="StandardFocusStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderThickness="3" BorderBrush="{DynamicResource PrimaryTextBrush}" CornerRadius="12" Margin="-3">
                            <Border.Effect>
                                <DropShadowEffect Color="White" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,40,0,0" FocusManager.IsFocusScope="True" KeyboardNavigation.DirectionalNavigation="Continue" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="TopNavPanel" Grid.Row="0" Orientation="Horizontal" Margin="40,0,0,30" KeyboardNavigation.DirectionalNavigation="Continue" PreviewKeyDown="TopNavPanel_PreviewKeyDown">
            <Button Content="Home" Click="Home_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Guide" Click="Guide_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Multiview" Click="NavMultiview_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Movies" Click="Movies_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Collections" Click="Collections_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Recordings" x:Name="RecordingsNavBtn" Style="{StaticResource NavPillActiveStyle}"/>
            <Button Content="Shows" Click="Shows_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Videos" Click="Videos_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Settings" Click="Settings_Click" Style="{StaticResource NavPillStyle}"/>

            <!-- NEW THEME TOGGLE BUTTON -->
            <Button x:Name="ThemeToggleBtn" FontFamily="Segoe MDL2 Assets" Content="&#xE708;" FontSize="20" Click="ThemeToggleBtn_Click" Style="{StaticResource NavPillStyle}"/>
        </StackPanel>

        <!-- SUB NAVIGATION TABS -->
        <StackPanel x:Name="SubNavPanel" Grid.Row="1" Orientation="Horizontal" Margin="40,0,0,20" KeyboardNavigation.DirectionalNavigation="Continue" PreviewKeyDown="SubNavPanel_PreviewKeyDown">
            <Button x:Name="TabMyRecordings" Content="My Recordings" Style="{StaticResource TabButtonActiveStyle}" Click="TabMyRecordings_Click"/>
            <Button x:Name="TabDiscover" Content="Discover Airings" Style="{StaticResource TabButtonStyle}" Click="TabDiscover_Click"/>
        </StackPanel>

        <!-- VIEW 1: EXISTING MY RECORDINGS -->
        <ScrollViewer x:Name="MyRecordingsContainer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" KeyboardNavigation.DirectionalNavigation="Continue" ScrollViewer.PanningMode="VerticalOnly">
            <StackPanel Margin="0,0,0,60" KeyboardNavigation.DirectionalNavigation="Continue">

                <StackPanel>
                    <TextBlock Text="Currently Recording" FontSize="24" FontWeight="Bold" Margin="40,0,0,10" Foreground="#D32F2F"/>

                    <TextBlock Text="No active recordings." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="16" FontStyle="Italic" Margin="40,0,0,40">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveRecordings.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Margin="0,0,0,40">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveRecordings.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ListBox x:Name="ActiveList" ItemsSource="{Binding ActiveRecordings}" Focusable="False" IsTabStop="False" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.ScrollChanged="HorizontalList_ScrollChanged"
                                 PreviewMouseWheel="HorizontalList_PreviewMouseWheel" KeyboardNavigation.DirectionalNavigation="Continue" ScrollViewer.PanningMode="HorizontalOnly">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal" Margin="40,15,40,25"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,20,0"/>
                                    <EventSetter Event="PreviewKeyDown" Handler="ListBoxItem_PreviewKeyDown"/>
                                    <EventSetter Event="MouseLeftButtonUp" Handler="RecordingCard_Click"/>
                                    <EventSetter Event="UIElement.GotKeyboardFocus" Handler="RecordingCard_GotKeyboardFocus"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="300" Height="170" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Cursor="Hand" ClipToBounds="True">
                                        <Border.Effect><DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/></Border.Effect>
                                        <Grid>
                                            <Image Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,300,170" RadiusX="12" RadiusY="12"/>
                                                </Image.Clip>
                                            </Image>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D32F2F" CornerRadius="0,12,0,8" Padding="10,5">
                                                <TextBlock Text="● REC" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                            </Border>
                                            <Border VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="#AAAAAA" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding CurrentShowTitle}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="&lt;" HorizontalAlignment="Left" Margin="15,0,0,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollLeft_Click" Tag="{Binding ElementName=ActiveList}"/>
                        <Button Content="&gt;" HorizontalAlignment="Right" Margin="0,0,15,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollRight_Click" Tag="{Binding ElementName=ActiveList}"/>
                    </Grid>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Upcoming Schedule" FontSize="24" FontWeight="Bold" Margin="40,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="No upcoming recordings scheduled." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="16" FontStyle="Italic" Margin="40,0,0,40">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScheduledRecordings.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Margin="0,0,0,40">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScheduledRecordings.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ListBox x:Name="ScheduledList" ItemsSource="{Binding ScheduledRecordings}" Focusable="False" IsTabStop="False" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.ScrollChanged="HorizontalList_ScrollChanged"
                                 PreviewMouseWheel="HorizontalList_PreviewMouseWheel" KeyboardNavigation.DirectionalNavigation="Continue" ScrollViewer.PanningMode="HorizontalOnly">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal" Margin="40,15,40,25"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,20,0"/>
                                    <EventSetter Event="PreviewKeyDown" Handler="ListBoxItem_PreviewKeyDown"/>
                                    <EventSetter Event="MouseLeftButtonUp" Handler="RecordingCard_Click"/>
                                    <EventSetter Event="UIElement.GotKeyboardFocus" Handler="RecordingCard_GotKeyboardFocus"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="300" Height="170" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Cursor="Hand" ClipToBounds="True">
                                        <Border.Effect><DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/></Border.Effect>
                                        <Grid>
                                            <Image Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,300,170" RadiusX="12" RadiusY="12"/>
                                                </Image.Clip>
                                            </Image>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#00A4EF" CornerRadius="0,12,0,8" Padding="10,5">
                                                <TextBlock Text="{Binding DisplayTime}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                            </Border>
                                            <Border VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="#AAAAAA" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding CurrentShowTitle}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="&lt;" HorizontalAlignment="Left" Margin="15,0,0,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollLeft_Click" Tag="{Binding ElementName=ScheduledList}"/>
                        <Button Content="&gt;" HorizontalAlignment="Right" Margin="0,0,15,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollRight_Click" Tag="{Binding ElementName=ScheduledList}"/>
                    </Grid>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Recent TV Shows" FontSize="24" FontWeight="Bold" Margin="40,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="No recent TV shows available." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="16" FontStyle="Italic" Margin="40,0,0,40">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentShows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Margin="0,0,0,60">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentShows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ListBox x:Name="RecentShowsList" ItemsSource="{Binding RecentShows}" Focusable="False" IsTabStop="False" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.ScrollChanged="HorizontalList_ScrollChanged"
                                 PreviewMouseWheel="HorizontalList_PreviewMouseWheel" KeyboardNavigation.DirectionalNavigation="Continue" ScrollViewer.PanningMode="HorizontalOnly">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal" Margin="40,15,40,25"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,20,0"/>
                                    <EventSetter Event="PreviewKeyDown" Handler="ListBoxItem_PreviewKeyDown"/>
                                    <EventSetter Event="MouseLeftButtonUp" Handler="RecordingCard_Click"/>
                                    <EventSetter Event="UIElement.GotKeyboardFocus" Handler="RecordingCard_GotKeyboardFocus"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="300" Height="170" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Cursor="Hand" ClipToBounds="True">
                                        <Border.Effect><DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/></Border.Effect>
                                        <Grid>
                                            <Image Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,300,170" RadiusX="12" RadiusY="12"/>
                                                </Image.Clip>
                                            </Image>
                                            <Border VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="#AAAAAA" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding CurrentShowTitle}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="&lt;" HorizontalAlignment="Left" Margin="15,0,0,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollLeft_Click" Tag="{Binding ElementName=RecentShowsList}"/>
                        <Button Content="&gt;" HorizontalAlignment="Right" Margin="0,0,15,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollRight_Click" Tag="{Binding ElementName=RecentShowsList}"/>
                    </Grid>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Recent Movies" FontSize="24" FontWeight="Bold" Margin="40,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="No recent movies available." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="16" FontStyle="Italic" Margin="40,0,0,40">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentMovies.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Margin="0,0,0,60">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentMovies.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ListBox x:Name="RecentMoviesList" ItemsSource="{Binding RecentMovies}" Focusable="False" IsTabStop="False" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.ScrollChanged="HorizontalList_ScrollChanged"
                                 PreviewMouseWheel="HorizontalList_PreviewMouseWheel" KeyboardNavigation.DirectionalNavigation="Continue" ScrollViewer.PanningMode="HorizontalOnly">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal" Margin="40,15,40,25"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,20,0"/>
                                    <EventSetter Event="PreviewKeyDown" Handler="ListBoxItem_PreviewKeyDown"/>
                                    <EventSetter Event="MouseLeftButtonUp" Handler="RecordingCard_Click"/>
                                    <EventSetter Event="UIElement.GotKeyboardFocus" Handler="RecordingCard_GotKeyboardFocus"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="200" Height="300" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Cursor="Hand" ClipToBounds="True">
                                        <Border.Effect><DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/></Border.Effect>
                                        <Grid>
                                            <Image Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,200,300" RadiusX="12" RadiusY="12"/>
                                                </Image.Clip>
                                            </Image>
                                            <Border VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="&lt;" HorizontalAlignment="Left" Margin="15,0,0,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollLeft_Click" Tag="{Binding ElementName=RecentMoviesList}"/>
                        <Button Content="&gt;" HorizontalAlignment="Right" Margin="0,0,15,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollRight_Click" Tag="{Binding ElementName=RecentMoviesList}"/>
                    </Grid>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Local Imports &amp; Virtual Media" FontSize="24" FontWeight="Bold" Margin="40,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="No local imports or virtual media found." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="16" FontStyle="Italic" Margin="40,0,0,40">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImportedMedia.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Margin="0,0,0,60">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImportedMedia.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ListBox x:Name="ImportedMediaList" ItemsSource="{Binding ImportedMedia}" Focusable="False" IsTabStop="False" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.ScrollChanged="HorizontalList_ScrollChanged"
                                 PreviewMouseWheel="HorizontalList_PreviewMouseWheel" KeyboardNavigation.DirectionalNavigation="Continue" ScrollViewer.PanningMode="HorizontalOnly">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal" Margin="40,15,40,25"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,20,0"/>
                                    <EventSetter Event="PreviewKeyDown" Handler="ListBoxItem_PreviewKeyDown"/>
                                    <EventSetter Event="MouseLeftButtonUp" Handler="RecordingCard_Click"/>
                                    <EventSetter Event="UIElement.GotKeyboardFocus" Handler="RecordingCard_GotKeyboardFocus"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="200" Height="300" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Cursor="Hand" ClipToBounds="True">
                                        <Border.Effect><DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/></Border.Effect>
                                        <Grid>
                                            <Image Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,200,300" RadiusX="12" RadiusY="12"/>
                                                </Image.Clip>
                                            </Image>
                                            <Border VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="&lt;" HorizontalAlignment="Left" Margin="15,0,0,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollLeft_Click" Tag="{Binding ElementName=ImportedMediaList}"/>
                        <Button Content="&gt;" HorizontalAlignment="Right" Margin="0,0,15,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollRight_Click" Tag="{Binding ElementName=ImportedMediaList}"/>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- VIEW 2: NEW DISCOVER AIRINGS -->
        <Grid x:Name="DiscoverContainer" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search and Filter Bar -->
            <Grid Margin="40,0,40,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="8" Padding="15,10" Margin="0,0,20,0" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                    <TextBox x:Name="DiscoverSearchBox" PreviewKeyDown="DiscoverSearchBox_PreviewKeyDown" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" FontSize="16" CaretBrush="{DynamicResource PrimaryTextBrush}" TextChanged="DiscoverSearchBox_TextChanged"/>
                </Border>
                <TextBlock Text="Search upcoming shows and movies..." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="16" IsHitTestVisible="False" Margin="15,12,0,0" VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=DiscoverSearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button x:Name="CollectionFilterBtn" Grid.Column="1" Width="220" Margin="0,0,15,0" Content="All Collections ▼"
                        Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" FontSize="16" FontWeight="SemiBold"
                        Click="CollectionFilterBtn_Click" PreviewKeyDown="FilterBtn_PreviewKeyDown" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="ChannelFilterBtn" Grid.Column="2" Width="260" Content="All Channels ▼"
                        Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" FontSize="16" FontWeight="SemiBold"
                        Click="ChannelFilterBtn_Click" PreviewKeyDown="FilterBtn_PreviewKeyDown" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

            </Grid>

            <!-- Lazy Loaded Linear Grid -->
            <ScrollViewer x:Name="DiscoverScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="DiscoverScroll_ScrollChanged" Focusable="False">
                <StackPanel Margin="0,0,0,60" KeyboardNavigation.DirectionalNavigation="Continue">
                    <ListBox x:Name="DiscoverGridList" ItemsSource="{Binding DiscoverResults}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             PreviewMouseWheel="DiscoverList_PreviewMouseWheel" KeyboardNavigation.DirectionalNavigation="Continue">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="40,0,0,0" KeyboardNavigation.DirectionalNavigation="Continue"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,20,30"/>
                                <EventSetter Event="MouseLeftButtonUp" Handler="DiscoverCard_Click"/>
                                <EventSetter Event="PreviewKeyDown" Handler="DiscoverItem_PreviewKeyDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="200" Height="300" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Cursor="Hand" ClipToBounds="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Image Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,200,300" RadiusX="12" RadiusY="12"/>
                                            </Image.Clip>
                                        </Image>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#00A4EF" CornerRadius="0,12,0,8" Padding="10,5">
                                            <TextBlock Text="{Binding DisplayTime}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                        <Border VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                                                <TextBlock Text="{Binding ChannelName}" Foreground="#AAAAAA" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="DiscoverLoadingText" Text="Loading Airings..." Foreground="{DynamicResource MutedTextBrush}" FontSize="16" HorizontalAlignment="Center" Margin="0,20" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- UNIFIED MODAL OVERLAY -->
        <Border x:Name="ModalOverlay" Grid.RowSpan="3" Background="{DynamicResource OverlayBackgroundBrush}" Visibility="Collapsed" VerticalAlignment="Bottom" Height="300" Padding="40" CornerRadius="24,24,0,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
            </Border.Effect>
            <Grid KeyboardNavigation.DirectionalNavigation="Cycle">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="*"/> <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="160" Height="220" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource PanelBackgroundBrush}" Margin="0,0,30,0">
                    <Image x:Name="ModalImage" Stretch="UniformToFill">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,160,220" RadiusX="12" RadiusY="12"/>
                        </Image.Clip>
                    </Image>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,30,0">
                    <TextBlock x:Name="ModalTitle" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <TextBlock x:Name="ModalSubTitle" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ModalTime" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,15" Visibility="Collapsed"/>
                    <TextBlock x:Name="ModalSummary" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="22" MaxHeight="100" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" KeyboardNavigation.DirectionalNavigation="Cycle">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.8"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>

                    <Button x:Name="ModalPlayBtn" Content="▶ Play" Width="160" Height="40" Background="{DynamicResource ActiveNavBackgroundBrush}" Foreground="{DynamicResource ActiveNavTextBrush}" FontWeight="Bold" FontSize="16" BorderThickness="0" Margin="0,0,0,15" Cursor="Hand" Click="ModalPlay_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>

                    <Button x:Name="ModalRecordBtn" Content="⏺ Record" Width="160" Height="40" Background="#D32F2F" Foreground="White" FontWeight="Bold" FontSize="16" BorderThickness="0" Margin="0,0,0,15" Cursor="Hand" Click="ModalRecord_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}" Visibility="Collapsed"/>

                    <Button x:Name="CloseModalBtn" Content="Close" Width="160" Height="40" Background="{DynamicResource NavBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" BorderThickness="0" Margin="0,0,0,15" Cursor="Hand" Click="CloseModal_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>

                    <Button x:Name="DeleteModalBtn" Content="🗑 Delete" Width="160" Height="40" Background="#8B0000" Foreground="White" FontWeight="SemiBold" FontSize="16" BorderThickness="0" Cursor="Hand" Click="DeleteModal_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- NEW: FILTER SELECTION OVERLAY -->
        <Border x:Name="FilterOverlay" Grid.RowSpan="3" Background="{DynamicResource OverlayBackgroundBrush}" Visibility="Collapsed" Panel.ZIndex="500">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="FilterOverlayTitle" Text="Select Option" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <ListBox x:Name="FilterSelectionList" Grid.Row="1" MaxHeight="500" MinWidth="350" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="FilterSelectionList_PreviewKeyDown"
                         MouseLeftButtonUp="FilterSelectionList_MouseUp">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="20,15"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{StaticResource StandardFocusStyle}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="2">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Simple string binding since these are just sorting/ordering strings -->
                            <TextBlock Text="{Binding}" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
