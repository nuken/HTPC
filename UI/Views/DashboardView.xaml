<UserControl x:Class="HTPC.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F0F0F" Foreground="White">

    <UserControl.Resources>
	    <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="BgBorder" Background="#2A2A2A" CornerRadius="8" Padding="15,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Fill="#B3B3B3" Data="M 0 0 L 5 5 L 10 0 Z" VerticalAlignment="Center" Margin="15,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BgBorder" Property="Background" Value="#404040"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            
                            <ContentPresenter IsHitTestVisible="False" Margin="15,10,35,10" VerticalAlignment="Center" TextElement.Foreground="White"
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#1E1E1E" CornerRadius="8" Margin="0,5,0,0" MinWidth="{TemplateBinding ActualWidth}" Padding="0,5">
                                    <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E6000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#404040"/> 
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#202020"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,30">
            <Border Background="White" CornerRadius="20" Padding="20,10" Margin="0,0,15,0" Cursor="Hand">
                <TextBlock Text="Home" Foreground="Black" FontWeight="Bold" FontSize="16"/>
            </Border>
            <Border Background="#2A2A2A" CornerRadius="20" Padding="20,10" Margin="0,0,15,0" Cursor="Hand">
                <TextBlock Text="Movies" Foreground="#B3B3B3" FontWeight="SemiBold" FontSize="16"/>
            </Border>
            <Border Background="#2A2A2A" CornerRadius="20" Padding="20,10" Margin="0,0,15,0" Cursor="Hand" MouseLeftButtonDown="Settings_Click">
                <TextBlock Text="Settings" Foreground="#B3B3B3" FontWeight="SemiBold" FontSize="16"/>
            </Border>
            <Border Background="#8B0000" CornerRadius="20" Padding="20,10" Margin="0,0,15,0" Cursor="Hand" MouseLeftButtonDown="ExitApp_Click">
                <TextBlock Text="Exit HTPC" Foreground="White" FontWeight="Bold" FontSize="16"/>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Live TV" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    
                    <ComboBox x:Name="CollectionDropdown" Grid.Column="1" Width="220" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                              DisplayMemberPath="Name" SelectionChanged="CollectionDropdown_SelectionChanged">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="15,10"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                            <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#404040"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                </Grid>
                
                <Grid Margin="0,0,0,40">
                    <ListBox x:Name="LiveTvList" ItemsSource="{Binding LiveChannels}" Background="Transparent" BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" IsVirtualizing="True" VirtualizationMode="Recycling"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,20,0"/>
                                <EventSetter Event="PreviewKeyDown" Handler="ListBoxItem_PreviewKeyDown"/>
                                <EventSetter Event="MouseLeftButtonUp" Handler="ListBoxItem_MouseUp"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="12" Padding="2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="FocusRing" Property="BorderBrush" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="200" Height="300" Background="#1E1E1E" CornerRadius="8" Cursor="Hand">
                                    <Grid>
                                        <Image Source="{Binding CurrentShowPosterUrl, IsAsync=True}" Stretch="UniformToFill" ClipToBounds="True" Opacity="0.8">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,200,300" RadiusX="8" RadiusY="8"/>
                                            </Image.Clip>
                                        </Image>
                                        
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#B3000000" CornerRadius="8,0,8,0" Padding="5">
                                            <Image Source="{Binding PosterUrl, IsAsync=True}" Width="40" Height="40" Stretch="Uniform"/>
                                        </Border>
                                        
                                        <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="10">
                                            <TextBlock Text="{Binding CurrentShowTitle}" Foreground="White" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Content="&lt;" Width="50" HorizontalAlignment="Left" Style="{StaticResource ScrollButtonStyle}" Click="ScrollLeft_Click" Tag="{Binding ElementName=LiveTvList}"/>
                    <Button Content="&gt;" Width="50" HorizontalAlignment="Right" Style="{StaticResource ScrollButtonStyle}" Click="ScrollRight_Click" Tag="{Binding ElementName=LiveTvList}"/>
                </Grid>              

                <TextBlock Text="Featured Movies" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
                <Grid Margin="0,0,0,40">
                    <ListBox x:Name="MoviesList" ItemsSource="{Binding FeaturedMovies}" Background="Transparent" BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" IsVirtualizing="True" VirtualizationMode="Recycling"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,20,0"/>
                                <EventSetter Event="PreviewKeyDown" Handler="ListBoxItem_PreviewKeyDown"/>
                                <EventSetter Event="MouseLeftButtonUp" Handler="ListBoxItem_MouseUp"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="12" Padding="2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="FocusRing" Property="BorderBrush" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="200" Height="300" Background="#1E1E1E" CornerRadius="8" Cursor="Hand">
                                    <Grid>
                                        <Image Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill" ClipToBounds="True">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,200,300" RadiusX="8" RadiusY="8"/>
                                            </Image.Clip>
                                        </Image>
                                        <Border VerticalAlignment="Bottom" Background="#B3000000" Padding="10">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Content="&lt;" Width="50" HorizontalAlignment="Left" Style="{StaticResource ScrollButtonStyle}" Click="ScrollLeft_Click" Tag="{Binding ElementName=MoviesList}"/>
                    <Button Content="&gt;" Width="50" HorizontalAlignment="Right" Style="{StaticResource ScrollButtonStyle}" Click="ScrollRight_Click" Tag="{Binding ElementName=MoviesList}"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>