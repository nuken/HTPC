<UserControl x:Class="HTPC.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource PrimaryTextBrush}"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>

        <Style x:Key="NavPillStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource NavBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavPillActiveStyle" TargetType="Button" BasedOn="{StaticResource NavPillStyle}">
            <Setter Property="Background" Value="{DynamicResource ActiveNavBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ActiveNavTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="NavPillExitStyle" TargetType="Button" BasedOn="{StaticResource NavPillStyle}">
            <Setter Property="Background" Value="#8B0000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TvGuideFocusStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderThickness="2" BorderBrush="{DynamicResource PrimaryTextBrush}" CornerRadius="6" Margin="-2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="#99000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="23">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#CC202020"/>
                                <Setter TargetName="bgBorder" Property="BorderBrush" Value="#88FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#E6000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>

        <Grid Margin="0,40,0,0" KeyboardNavigation.DirectionalNavigation="Continue" KeyboardNavigation.TabNavigation="Cycle">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    </Grid.RowDefinitions>

            <Border x:Name="UpdateBanner" Grid.Row="0" Background="#1A73E8" Visibility="Collapsed" Padding="20,15" Margin="20,0,20,30" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="20" Margin="0,0,10,0"/>
                        <TextBlock x:Name="UpdateMessageText" Foreground="White" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Text="A new update is available!"/>
                    </StackPanel>

                    <Button x:Name="BtnDownloadUpdate" Grid.Column="1" Content="Download" Margin="0,0,15,0" Style="{StaticResource NavPillActiveStyle}" Background="White" Foreground="Black" Click="BtnDownloadUpdate_Click"/>

                    <Button x:Name="BtnIgnoreUpdate" Grid.Column="2" Content="Ignore for 1 week" Style="{StaticResource NavPillStyle}" Background="#33FFFFFF" Foreground="White" Click="BtnIgnoreUpdate_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,0,0,30" KeyboardNavigation.DirectionalNavigation="Continue">
                <Button x:Name="HomeNavBtn" Content="Home" Style="{StaticResource NavPillActiveStyle}"/>
                <Button Content="Guide" Click="Guide_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Multiview" Click="NavMultiview_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Movies" Click="Movies_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Collections" Click="Collections_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Recordings" Click="Recordings_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Shows" Click="Shows_Click" Style="{StaticResource NavPillStyle}"/>
				<Button Content="Sports" Click="Sports_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Videos" Click="Videos_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Settings" Click="Settings_Click" Style="{StaticResource NavPillStyle}"/>

                <!-- NEW THEME TOGGLE BUTTON -->
                <Button x:Name="ThemeToggleBtn" FontFamily="Segoe MDL2 Assets" Content="&#xE708;" FontSize="20" Click="ThemeToggleBtn_Click" Style="{StaticResource NavPillStyle}"/>

            </StackPanel>

            <ScrollViewer x:Name="MainScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
              KeyboardNavigation.DirectionalNavigation="Continue" ScrollViewer.PanningMode="VerticalOnly">

                <StackPanel x:Name="DashboardContentPanel" Margin="0,0,0,60" KeyboardNavigation.DirectionalNavigation="Continue">

                    <StackPanel x:Name="SectionUpNext">
                        <TextBlock Text="Up Next" FontSize="24" FontWeight="Bold" Margin="40,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Grid Margin="0,0,0,60">
                            <ListBox x:Name="UpNextList" ItemsSource="{Binding UpNextQueue}" Focusable="False" IsTabStop="False" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                     PreviewMouseWheel="HorizontalList_PreviewMouseWheel" KeyboardNavigation.DirectionalNavigation="Continue" ScrollViewer.PanningMode="HorizontalOnly">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Horizontal" Margin="40,15,40,25"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,20,0"/>

                                        <!-- The Keyboard Enter Key -->
                                        <EventSetter Event="PreviewKeyDown" Handler="ListBoxItem_PreviewKeyDown"/>

                                        <!-- THE NEW TOUCH/MOUSE PREVIEW EVENTS -->
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown"/>
                                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ListBoxItem_PreviewMouseLeftButtonUp"/>

                                        <Setter Property="Template">

                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="320" Height="180" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Cursor="Hand" ClipToBounds="True">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Image Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill" HorizontalAlignment="Center">
                                                    <Image.Clip>
                                                        <RectangleGeometry Rect="0,0,320,180" RadiusX="12" RadiusY="12"/>
                                                    </Image.Clip>
                                                </Image>

                                                <Border VerticalAlignment="Bottom" Height="60">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00000000" Offset="0"/>
                                                            <GradientStop Color="#E6000000" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel VerticalAlignment="Bottom" Margin="15,10">
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="▶ Resume" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button Content="&lt;" HorizontalAlignment="Left" Margin="15,0,0,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollLeft_Click" Tag="{Binding ElementName=UpNextList}"/>
                            <Button Content="&gt;" HorizontalAlignment="Right" Margin="0,0,15,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollRight_Click" Tag="{Binding ElementName=UpNextList}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="SectionLiveTv">
                        <Grid Margin="40,0,40,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fav TV" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <!-- UI UPDATED: Replaced ComboBox with Overlay Trigger Button -->
                            <Button x:Name="CollectionFilterBtn" Grid.Column="1" Width="220" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Content="All Channels ▼" Background="{DynamicResource NavBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0"
                                    FontSize="16" FontWeight="SemiBold" Padding="15,10"
                                    Click="CollectionFilterBtn_Click" PreviewKeyDown="FilterBtn_PreviewKeyDown"
                                    FocusVisualStyle="{StaticResource TvGuideFocusStyle}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,60">
                            <ListBox x:Name="LiveTvList" ItemsSource="{Binding LiveChannels}" Focusable="False" IsTabStop="False" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                     PreviewMouseWheel="HorizontalList_PreviewMouseWheel" KeyboardNavigation.DirectionalNavigation="Continue" ScrollViewer.PanningMode="HorizontalOnly">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Horizontal" Margin="40,15,40,25"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,20,0"/>

                                        <!-- The Keyboard Enter Key -->
                                        <EventSetter Event="PreviewKeyDown" Handler="ListBoxItem_PreviewKeyDown"/>

                                        <!-- THE NEW TOUCH/MOUSE PREVIEW EVENTS -->
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown"/>
                                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ListBoxItem_PreviewMouseLeftButtonUp"/>

                                        <Setter Property="Template">

                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="200" Height="300" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Cursor="Hand">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Image Source="{Binding CurrentShowPosterUrl, IsAsync=True}" Stretch="UniformToFill" ClipToBounds="True" Opacity="0.9">
                                                    <Image.Clip>
                                                        <RectangleGeometry Rect="0,0,200,300" RadiusX="12" RadiusY="12"/>
                                                    </Image.Clip>
                                                </Image>

                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CCEEEEEE" CornerRadius="12,0,12,0" Padding="8">
                                                    <Image Source="{Binding PosterUrl, IsAsync=True}" Width="40" Height="40" Stretch="Uniform"/>
                                                </Border>

                                                <Border VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                                    <TextBlock Text="{Binding CurrentShowTitle}" Foreground="White" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="&lt;" HorizontalAlignment="Left" Margin="15,0,0,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollLeft_Click" Tag="{Binding ElementName=LiveTvList}"/>
                            <Button Content="&gt;" HorizontalAlignment="Right" Margin="0,0,15,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollRight_Click" Tag="{Binding ElementName=LiveTvList}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="SectionMovies">
                        <TextBlock Text="Recent Movies" FontSize="24" FontWeight="Bold" Margin="40,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Grid Margin="0,0,0,60">
                            <ListBox x:Name="MoviesList" ItemsSource="{Binding FeaturedMovies}" Focusable="False" IsTabStop="False" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                     PreviewMouseWheel="HorizontalList_PreviewMouseWheel" KeyboardNavigation.DirectionalNavigation="Continue" ScrollViewer.PanningMode="HorizontalOnly">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Horizontal" Margin="40,15,40,25"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,20,0"/>

                                        <!-- The Keyboard Enter Key -->
                                        <EventSetter Event="PreviewKeyDown" Handler="ListBoxItem_PreviewKeyDown"/>

                                        <!-- THE NEW TOUCH/MOUSE PREVIEW EVENTS -->
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown"/>
                                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ListBoxItem_PreviewMouseLeftButtonUp"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="200" Height="300" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Cursor="Hand">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Image Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill" ClipToBounds="True">
                                                    <Image.Clip>
                                                        <RectangleGeometry Rect="0,0,200,300" RadiusX="12" RadiusY="12"/>
                                                    </Image.Clip>
                                                </Image>
                                                <Border VerticalAlignment="Bottom" Background="#B3000000" Padding="12" CornerRadius="0,0,12,12">
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="&lt;" HorizontalAlignment="Left" Margin="15,0,0,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollLeft_Click" Tag="{Binding ElementName=MoviesList}"/>
                            <Button Content="&gt;" HorizontalAlignment="Right" Margin="0,0,15,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollRight_Click" Tag="{Binding ElementName=MoviesList}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="SectionShows">
                        <TextBlock Text="Recent Episodes" FontSize="24" FontWeight="Bold" Margin="40,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Grid Margin="0,0,0,60">
                            <ListBox x:Name="EpisodesList" ItemsSource="{Binding RecentEpisodes}" Focusable="False" IsTabStop="False" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                     PreviewMouseWheel="HorizontalList_PreviewMouseWheel" KeyboardNavigation.DirectionalNavigation="Continue" ScrollViewer.PanningMode="HorizontalOnly">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Horizontal" Margin="40,15,40,25"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,20,0"/>

                                        <!-- The Keyboard Enter Key -->
                                        <EventSetter Event="PreviewKeyDown" Handler="ListBoxItem_PreviewKeyDown"/>

                                        <!-- THE NEW TOUCH/MOUSE PREVIEW EVENTS -->
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown"/>
                                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ListBoxItem_PreviewMouseLeftButtonUp"/>

                                        <Setter Property="Template">

                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="300" Height="170" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Cursor="Hand">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Image Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill" ClipToBounds="True" Opacity="0.9">
                                                    <Image.Clip>
                                                        <RectangleGeometry Rect="0,0,300,170" RadiusX="12" RadiusY="12"/>
                                                    </Image.Clip>
                                                </Image>
                                                <Border VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" Foreground="#AAAAAA" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding CurrentShowTitle}" Foreground="White" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="&lt;" HorizontalAlignment="Left" Margin="15,0,0,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollLeft_Click" Tag="{Binding ElementName=EpisodesList}"/>
                            <Button Content="&gt;" HorizontalAlignment="Right" Margin="0,0,15,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollRight_Click" Tag="{Binding ElementName=EpisodesList}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="SectionVideos">
                        <TextBlock Text="Recent Videos" FontSize="24" FontWeight="Bold" Margin="40,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Grid Margin="0,0,0,40">
                            <ListBox x:Name="VideosList" ItemsSource="{Binding RecentVideos}" Focusable="False" IsTabStop="False" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                     PreviewMouseWheel="HorizontalList_PreviewMouseWheel" KeyboardNavigation.DirectionalNavigation="Continue" ScrollViewer.PanningMode="HorizontalOnly">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Horizontal" Margin="40,15,40,25"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,20,0"/>

                                        <!-- The Keyboard Enter Key -->
                                        <EventSetter Event="PreviewKeyDown" Handler="ListBoxItem_PreviewKeyDown"/>

                                        <!-- THE NEW TOUCH/MOUSE PREVIEW EVENTS -->
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown"/>
                                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ListBoxItem_PreviewMouseLeftButtonUp"/>

                                        <Setter Property="Template">

                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="300" Height="170" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Cursor="Hand">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Image Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill" ClipToBounds="True" Opacity="0.9">
                                                    <Image.Clip>
                                                        <RectangleGeometry Rect="0,0,300,170" RadiusX="12" RadiusY="12"/>
                                                    </Image.Clip>
                                                </Image>
                                                <Border VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" Foreground="#AAAAAA" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding CurrentShowTitle}" Foreground="White" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="&lt;" HorizontalAlignment="Left" Margin="15,0,0,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollLeft_Click" Tag="{Binding ElementName=VideosList}"/>
                            <Button Content="&gt;" HorizontalAlignment="Right" Margin="0,0,15,10" Style="{StaticResource ScrollButtonStyle}" Click="ScrollRight_Click" Tag="{Binding ElementName=VideosList}"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- FILTER SELECTION OVERLAY -->
        <Border x:Name="FilterOverlay" Grid.RowSpan="3" Background="{DynamicResource OverlayBackgroundBrush}" Visibility="Collapsed" Panel.ZIndex="600">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="FilterOverlayTitle" Text="Select TV Collection" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <ListBox x:Name="FilterSelectionList" Grid.Row="1" MaxHeight="500" Width="450" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="FilterSelectionList_PreviewKeyDown"
                         MouseLeftButtonUp="FilterSelectionList_MouseUp">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="20,15"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{StaticResource TvGuideFocusStyle}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="2">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border x:Name="LoadingOverlay" Background="{DynamicResource AppBackgroundBrush}" Panel.ZIndex="1000" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="Loading your library..." FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Almost done..." FontSize="16" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
