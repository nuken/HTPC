<UserControl x:Class="HTPC.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="NavPillStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource NavBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavPillActiveStyle" TargetType="Button" BasedOn="{StaticResource NavPillStyle}">
            <Setter Property="Background" Value="{DynamicResource ActiveNavBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ActiveNavTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,30,0"/>
            <Setter Property="Padding" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style x:Key="StandardFocusStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderThickness="3" BorderBrush="{DynamicResource PrimaryTextBrush}" CornerRadius="12" Margin="-3">
                            <Border.Effect>
                                <DropShadowEffect Color="White" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40" FocusManager.IsFocusScope="True"
          KeyboardNavigation.DirectionalNavigation="Continue"
          KeyboardNavigation.TabNavigation="Cycle">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <Grid>
                <StackPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Continue">
                    <Button x:Name="HomeNavBtn" Content="Home" Click="Home_Click" Style="{StaticResource NavPillStyle}"/>
                    <Button Content="Guide" Click="Guide_Click" Style="{StaticResource NavPillStyle}"/>
                    <Button Content="Multiview" Click="NavMultiview_Click" Style="{StaticResource NavPillStyle}"/>
                    <Button Content="Movies" Click="Movies_Click" Style="{StaticResource NavPillStyle}"/>
                    <Button Content="Collections" Click="Collections_Click" Style="{StaticResource NavPillStyle}"/>
                    <Button Content="Recordings" Click="Recordings_Click" Style="{StaticResource NavPillStyle}"/>
                    <Button Content="Shows" Click="Shows_Click" Style="{StaticResource NavPillStyle}"/>
					<Button Content="Sports" Click="Sports_Click" Style="{StaticResource NavPillStyle}"/>
                    <Button Content="Videos" Click="Videos_Click" Style="{StaticResource NavPillStyle}"/>

                    <Button x:Name="SettingsNavBtn" Content="Settings" Style="{StaticResource NavPillActiveStyle}"/>

                    <!-- NEW THEME TOGGLE BUTTON -->
                    <Button x:Name="ThemeToggleBtn" FontFamily="Segoe MDL2 Assets" Content="&#xE708;" FontSize="20" Click="ThemeToggleBtn_Click" Style="{StaticResource NavPillStyle}"/>
                    
                </StackPanel>

            </Grid>

            <TextBlock x:Name="VersionText" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="5,10,0,0"/>
        </StackPanel>

        <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,20,0" Focusable="False" IsTabStop="False" GotKeyboardFocus="MainScroll_GotKeyboardFocus">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,40,20" KeyboardNavigation.DirectionalNavigation="Continue">
                    <TextBlock Text="Add Channel DVR Server" FontSize="26" FontWeight="Bold" Margin="0,0,0,30" Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="Server Alias (e.g. Living Room)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtName" PreviewKeyDown="TextBox_PreviewKeyDown" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" Padding="10" Margin="0,0,0,20" FontSize="16" CaretBrush="{DynamicResource PrimaryTextBrush}" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>

                    <TextBlock Text="IP Address" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtIp" PreviewKeyDown="TextBox_PreviewKeyDown" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" Padding="10" Margin="0,0,0,20" FontSize="16" CaretBrush="{DynamicResource PrimaryTextBrush}" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>

                    <TextBlock Text="Port (Default: 8089)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtPort" PreviewKeyDown="TextBox_PreviewKeyDown" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" Padding="10" Margin="0,0,0,30" FontSize="16" Text="8089" CaretBrush="{DynamicResource PrimaryTextBrush}" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>

                    <Button Content="Save Server" Background="#8B0000" Foreground="White" BorderThickness="0" Padding="15" FontSize="16" FontWeight="Bold" Cursor="Hand" Click="SaveServer_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#A50000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="Recording Preferences" FontSize="26" FontWeight="Bold" Margin="0,40,0,20" Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Padding Before (Start):" Foreground="{DynamicResource MutedTextBrush}" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0" Width="180"/>
                        <Button x:Name="PaddingStartBtn" Width="130" Height="45" Content="None ▼"
                                Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" FontSize="16" FontWeight="SemiBold"
                                Click="PaddingStartBtn_Click" PreviewKeyDown="FilterBtn_PreviewKeyDown" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <TextBlock Text="Padding After (End):" Foreground="{DynamicResource MutedTextBrush}" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0" Width="180"/>
                        <Button x:Name="PaddingEndBtn" Width="130" Height="45" Content="None ▼"
                                Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" FontSize="16" FontWeight="SemiBold"
                                Click="PaddingEndBtn_Click" PreviewKeyDown="FilterBtn_PreviewKeyDown" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>

					<TextBlock Text="Playback Settings" FontSize="26" FontWeight="Bold" Margin="0,20,0,20" Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <TextBlock Text="Commercial Skip:" Foreground="{DynamicResource MutedTextBrush}" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0" Width="180"/>
                        <Button x:Name="CommercialSkipBtn" Width="280" Height="45" Content="Automatic (Seamless) ▼"
                                Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" FontSize="16" FontWeight="SemiBold"
                                Click="CommercialSkipBtn_Click" PreviewKeyDown="FilterBtn_PreviewKeyDown" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
					
					<StackPanel Orientation="Horizontal" Margin="0,0,0,15">
    <TextBlock Text="Skip Forward Amount:" Foreground="{DynamicResource MutedTextBrush}" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0" Width="180"/>
    <Button x:Name="SkipForwardBtn" Width="280" Height="45" Content="30 Seconds ▼"
            Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" FontSize="16" FontWeight="SemiBold"
            Click="SkipForwardBtn_Click" PreviewKeyDown="FilterBtn_PreviewKeyDown" FocusVisualStyle="{StaticResource StandardFocusStyle}">
        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
    </Button>
</StackPanel>

<StackPanel Orientation="Horizontal" Margin="0,0,0,30">
    <TextBlock Text="Skip Backward Amount:" Foreground="{DynamicResource MutedTextBrush}" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0" Width="180"/>
    <Button x:Name="SkipBackwardBtn" Width="280" Height="45" Content="15 Seconds ▼"
            Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" FontSize="16" FontWeight="SemiBold"
            Click="SkipBackwardBtn_Click" PreviewKeyDown="FilterBtn_PreviewKeyDown" FocusVisualStyle="{StaticResource StandardFocusStyle}">
        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
    </Button>
</StackPanel>
                    <!-- Instant Replay Duration -->
<StackPanel Orientation="Horizontal" Margin="0,0,0,20">
    <TextBlock Text="Instant Replay Time" Width="250" VerticalAlignment="Center" FontSize="18" Foreground="{DynamicResource PrimaryTextBrush}"/>
    <Button x:Name="ReplayDurationBtn" Width="180" Height="45" Content="20 Seconds" Click="ReplayDurationBtn_Click" Style="{StaticResource NavPillStyle}"/>
</StackPanel>

<!-- Slow Motion Toggle -->
<StackPanel Orientation="Horizontal" Margin="0,0,0,20">
    <TextBlock Text="Replay Slow Motion" Width="250" VerticalAlignment="Center" FontSize="18" Foreground="{DynamicResource PrimaryTextBrush}"/>
    <Button x:Name="ReplaySlowMoBtn" Width="180" Height="45" Content="Enabled (0.5x)" Click="ReplaySlowMoBtn_Click" Style="{StaticResource NavPillStyle}"/>
</StackPanel>

					<TextBlock Text="Dashboard Layout" FontSize="26" FontWeight="Bold" Margin="0,40,0,20" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <Grid Margin="0,0,0,40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                       <ListBox x:Name="DashboardLayoutList" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="0" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" Padding="10" Height="260"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 Focusable="False" IsTabStop="False">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,15"/>
                                    <Setter Property="Margin" Value="0,0,0,5"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <EventSetter Event="PreviewKeyDown" Handler="DashboardListItem_PreviewKeyDown"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                        <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,15,0" Foreground="{DynamicResource PrimaryTextBrush}"/>

                                        <TextBlock Grid.Column="1" Text="{Binding IsVisible, StringFormat='Visible: {0}'}"
                                                   Foreground="{DynamicResource AccentBrush}" FontSize="14" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Column="1" Margin="30,0,0,0" VerticalAlignment="Center">
                            <Button x:Name="LayoutMoveUpBtn" Content="Move Up ⬆" Click="MoveRowUp_Click" PreviewKeyDown="LayoutActionBtn_PreviewKeyDown" Style="{StaticResource NavPillStyle}" Margin="0,0,0,15" Width="180"/>
                            <Button x:Name="LayoutMoveDownBtn" Content="Move Down ⬇" Click="MoveRowDown_Click" PreviewKeyDown="LayoutActionBtn_PreviewKeyDown" Style="{StaticResource NavPillStyle}" Margin="0,0,0,15" Width="180"/>
                            <Button x:Name="LayoutToggleBtn" Content="Toggle Visibility 👁" Click="ToggleRowVisibility_Click" PreviewKeyDown="LayoutActionBtn_PreviewKeyDown" Style="{StaticResource NavPillStyle}" Width="180"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Display Settings" FontSize="26" FontWeight="Bold" Margin="0,20,0,20" Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <TextBlock Text="UI Scale:" Foreground="{DynamicResource MutedTextBrush}" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0" Width="180"/>
                        <Slider x:Name="UiScaleSlider" PreviewKeyDown="Slider_PreviewKeyDown" Width="200" Minimum="0.8" Maximum="2.0" Value="1.0"
                                TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Cursor="Hand" ValueChanged="UiScaleSlider_ValueChanged"
                                Thumb.DragCompleted="UiScaleSlider_DragCompleted"
                                FocusVisualStyle="{StaticResource StandardFocusStyle}"/>
                        <TextBlock x:Name="UiScaleTextText" Text="100%" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </StackPanel>
					
					<StackPanel Orientation="Horizontal" Margin="0,0,0,30">
    <TextBlock Text="Sports Spoilers:" Foreground="{DynamicResource MutedTextBrush}" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0" Width="180"/>
    <CheckBox x:Name="HideScoresCheck" PreviewKeyDown="CheckBox_PreviewKeyDown" Content="Hide Live Scores on Airing Now Tiles"
              Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" VerticalAlignment="Center" Cursor="Hand"
              Checked="HideScoresCheck_Changed" Unchecked="HideScoresCheck_Changed"
              FocusVisualStyle="{StaticResource StandardFocusStyle}">
        <CheckBox.LayoutTransform>
            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
        </CheckBox.LayoutTransform>
    </CheckBox>
</StackPanel>

					<TextBlock Text="Video Processing" FontSize="26" FontWeight="Bold" Margin="0,40,0,20" Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Hardware Upscaling:" Foreground="{DynamicResource MutedTextBrush}" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0" Width="240"/>

                        <CheckBox x:Name="EnableUpscalingCheck" PreviewKeyDown="CheckBox_PreviewKeyDown" Content="Enable External Shaders (High GPU Usage)"
                                  Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" VerticalAlignment="Center" Cursor="Hand"
                                  Checked="UpscalerCheck_Changed" Unchecked="UpscalerCheck_Changed"
                                  FocusVisualStyle="{StaticResource StandardFocusStyle}">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <TextBlock Text="Upscaler Quality:" Foreground="{DynamicResource MutedTextBrush}" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0" Width="180"/>
                        <Button x:Name="UpscalerPresetBtn" Width="280" Height="45" Content="RAVU (Mid-Range GPUs) ▼"
                                Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" FontSize="16" FontWeight="SemiBold"
                                Click="UpscalerPresetBtn_Click" PreviewKeyDown="FilterBtn_PreviewKeyDown" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                <TextBlock Text="System" FontSize="26" FontWeight="Bold" Margin="0,20,0,20" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <Button Content="⏻ Exit Application" Width="280" Height="45" HorizontalAlignment="Left" Background="#8B0000" Foreground="White" BorderThickness="0" FontSize="16" FontWeight="Bold" Cursor="Hand" Click="ExitApp_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
        </Button>

    </StackPanel>

                <StackPanel Grid.Column="1" KeyboardNavigation.DirectionalNavigation="Continue">
    <Grid Margin="0,0,0,30">
        <TextBlock Text="Saved Connections" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
        
        <Button Content="Server Actions ⚡" HorizontalAlignment="Right" Background="{DynamicResource NavBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" Padding="15,8" FontSize="16" FontWeight="Bold" Cursor="Hand" Click="AdminMenu_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Scan Personal Media" Click="AdminAction_Click" Tag="/dvr/scanner/scan"/>
                    <MenuItem Header="Prune Removed Media" Click="AdminAction_Click" Tag="/dvr/scanner/imports/prune"/>
                    <MenuItem Header="Refresh Virtual Channels" Click="AdminAction_Click" Tag="/dvr/lineups/X-VIRTUAL"/>
                    <MenuItem Header="Clear Streaming Cache" Click="AdminAction_Click" Tag="/dvr/cache"/>
                    <MenuItem Header="Fetch Guide Updates" Click="AdminAction_Click" Tag="/dvr/guide?force="/>
                    <MenuItem Header="Re-Download Entire Guide" Click="AdminAction_Click" Tag="/dvr/guide?force=true"/>
                    <MenuItem Header="Empty Trash" Click="AdminAction_Click" Tag="/dvr/trash/empty"/>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
    </Grid>

                    <ListBox x:Name="SavedServersList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Continue">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,15"/>
                                <EventSetter Event="PreviewKeyDown" Handler="SavedServerItem_PreviewKeyDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="12" Padding="2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"  Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18"/>
                                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="http://{0}:{1}">
                                                        <Binding Path="IpAddress"/>
                                                        <Binding Path="Port"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>

                                        <Border x:Name="ActiveBadge" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#006400" CornerRadius="5" Padding="10,5" Margin="0,0,15,0" Visibility="Collapsed">
                                            <TextBlock Text="ACTIVE" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                        </Border>

                                        <Button x:Name="MakeActiveBtn" Grid.Column="1" Content="Make Active" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" Padding="10,5" Margin="0,0,15,0" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="MakeActive_Click" Visibility="Visible">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="MakeBtnBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="MakeBtnBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="MakeBtnBorder" Property="Background" Value="{DynamicResource PrimaryTextBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource AppBackgroundBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button Grid.Column="2" Content="X" Width="35" Height="35" Background="#8B0000" Foreground="White" BorderThickness="0" FontSize="16" FontWeight="Bold" Cursor="Hand" Click="DeleteServer_Click" Focusable="False" ToolTip="Delete Server">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="DelBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="DelBorder" Property="Background" Value="#A50000"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="ActiveBadge" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="MakeActiveBtn" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- FILTER SELECTION OVERLAY -->
        <Border x:Name="FilterOverlay" Grid.RowSpan="2" Background="{DynamicResource OverlayBackgroundBrush}" Visibility="Collapsed" Panel.ZIndex="600">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="FilterOverlayTitle" Text="Select Option" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <ListBox x:Name="FilterSelectionList" Grid.Row="1" MaxHeight="500" MinWidth="350" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="FilterSelectionList_PreviewKeyDown"
                         MouseLeftButtonUp="FilterSelectionList_MouseUp">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="20,15"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{StaticResource StandardFocusStyle}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="2">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

    </Grid>
</UserControl>
