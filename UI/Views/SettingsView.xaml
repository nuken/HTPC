<UserControl x:Class="HTPC.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F0F0F" Foreground="White">
             
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>  <ColumnDefinition Width="*"/>  </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,30">
            <Border Background="#2A2A2A" CornerRadius="20" Padding="20,10" Margin="0,0,15,0" Cursor="Hand" MouseLeftButtonDown="Home_Click">
                <TextBlock Text="Home" Foreground="#B3B3B3" FontWeight="Bold" FontSize="16"/>
            </Border>
            <TextBlock Text="Settings &amp; Servers" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,40,0">
            <TextBlock Text="Add Channel DVR Server" FontSize="26" FontWeight="Bold" Margin="0,0,0,30"/>
            
            <TextBlock Text="Server Alias (e.g. Living Room)" Foreground="#B3B3B3" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtName" Background="#1E1E1E" Foreground="White" BorderThickness="0" Padding="10" Margin="0,0,0,20" FontSize="16"/>

            <TextBlock Text="IP Address" Foreground="#B3B3B3" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtIp" Background="#1E1E1E" Foreground="White" BorderThickness="0" Padding="10" Margin="0,0,0,20" FontSize="16"/>

            <TextBlock Text="Port (Default: 8089)" Foreground="#B3B3B3" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtPort" Background="#1E1E1E" Foreground="White" BorderThickness="0" Padding="10" Margin="0,0,0,30" FontSize="16" Text="8089"/>

            <Button Content="Save Server" Background="#8B0000" Foreground="White" BorderThickness="0" Padding="15" FontSize="16" FontWeight="Bold" Cursor="Hand" Click="SaveServer_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBlock Text="Saved Connections" FontSize="26" FontWeight="Bold" Margin="0,0,0,30"/>
            
            <ItemsControl x:Name="SavedServersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E1E1E" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18"/>
                                    
                                    <TextBlock Foreground="#B3B3B3" Margin="0,5,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="http://{0}:{1}">
                                                <Binding Path="IpAddress"/>
                                                <Binding Path="Port"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#006400" CornerRadius="5" Padding="10,5" 
                                        Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="ACTIVE" FontWeight="Bold" FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>