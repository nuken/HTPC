<UserControl x:Class="HTPC.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F0F0F" Foreground="White">
             
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="NavPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#B3B3B3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#444444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavPillActiveStyle" TargetType="Button" BasedOn="{StaticResource NavPillStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Focusable" Value="False"/> 
        </Style>

        <Style x:Key="StandardFocusStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderThickness="2" BorderBrush="White" CornerRadius="8" Margin="-2">
                            <Border.Effect>
                                <DropShadowEffect Color="White" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border Background="#1E1E1E" CornerRadius="8" BorderThickness="0">
                <Path x:Name="Arrow" Fill="#AAAAAA" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" Data="M 0 0 L 5 5 L 10 0 Z"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Arrow" Property="Fill" Value="White"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource StandardFocusStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#2A2A2A" CornerRadius="8" Margin="0,5,0,0">
                                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.5"/></Border.Effect>
                                        <ScrollViewer Margin="0,5" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="5,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#8B0000"/> 
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40" FocusManager.IsFocusScope="True" 
          KeyboardNavigation.DirectionalNavigation="Continue" 
          KeyboardNavigation.TabNavigation="Cycle">
          
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="*"/>    
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,30" KeyboardNavigation.DirectionalNavigation="Continue">
            <Button Content="Home" Click="Home_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Guide" Click="Guide_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Movies" Click="Movies_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Shows" Click="Shows_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Videos" Click="Videos_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Settings" Style="{StaticResource NavPillActiveStyle}"/>
            <TextBlock Text="App Configuration" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#555555"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>  
                    <ColumnDefinition Width="*"/>  
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,40,20" KeyboardNavigation.DirectionalNavigation="Continue">
                    <TextBlock Text="Add Channel DVR Server" FontSize="26" FontWeight="Bold" Margin="0,0,0,30"/>
                    
                    <TextBlock Text="Server Alias (e.g. Living Room)" Foreground="#B3B3B3" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtName" Background="#1E1E1E" Foreground="White" BorderThickness="0" Padding="10" Margin="0,0,0,20" FontSize="16" CaretBrush="White" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>

                    <TextBlock Text="IP Address" Foreground="#B3B3B3" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtIp" Background="#1E1E1E" Foreground="White" BorderThickness="0" Padding="10" Margin="0,0,0,20" FontSize="16" CaretBrush="White" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>

                    <TextBlock Text="Port (Default: 8089)" Foreground="#B3B3B3" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtPort" Background="#1E1E1E" Foreground="White" BorderThickness="0" Padding="10" Margin="0,0,0,30" FontSize="16" Text="8089" CaretBrush="White" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>

                    <Button Content="Save Server" Background="#8B0000" Foreground="White" BorderThickness="0" Padding="15" FontSize="16" FontWeight="Bold" Cursor="Hand" Click="SaveServer_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#A50000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <TextBlock Text="Recording Preferences" FontSize="26" FontWeight="Bold" Margin="0,40,0,20"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Padding Before (Start):" Foreground="#B3B3B3" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0" Width="180"/>
                        <ComboBox x:Name="PaddingStartBox" FontSize="16" Width="130" Height="45" 
                                  Style="{StaticResource DarkComboBoxStyle}" 
                                  ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}" 
                                  SelectionChanged="Padding_SelectionChanged"/>
                    </StackPanel>
            
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <TextBlock Text="Padding After (End):" Foreground="#B3B3B3" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0" Width="180"/>
                        <ComboBox x:Name="PaddingEndBox" FontSize="16" Width="130" Height="45" 
                                  Style="{StaticResource DarkComboBoxStyle}" 
                                  ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}" 
                                  SelectionChanged="Padding_SelectionChanged"/>
                    </StackPanel>

                    <TextBlock Text="Display Settings" FontSize="26" FontWeight="Bold" Margin="0,20,0,20"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <TextBlock Text="UI Scale:" Foreground="#B3B3B3" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0" Width="180"/>
                        <Slider x:Name="UiScaleSlider" Width="200" Minimum="0.8" Maximum="2.0" Value="1.0" 
                        TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center" 
                        Cursor="Hand" ValueChanged="UiScaleSlider_ValueChanged"
                        Thumb.DragCompleted="UiScaleSlider_DragCompleted"/>
                        <TextBlock x:Name="UiScaleTextText" Text="100%" Foreground="White" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </StackPanel>
					
					<TextBlock Text="Video Processing" FontSize="26" FontWeight="Bold" Margin="0,40,0,20"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Hardware Upscaling:" Foreground="#B3B3B3" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0" Width="240"/>
                        
                        <CheckBox x:Name="EnableUpscalingCheck" Content="Enable External Shaders (High GPU Usage)" 
                                  Foreground="White" FontSize="14" VerticalAlignment="Center" Cursor="Hand"
                                  Checked="Upscaler_SelectionChanged" Unchecked="Upscaler_SelectionChanged">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <TextBlock Text="Upscaler Quality:" Foreground="#B3B3B3" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0" Width="180"/>
                        
                        <ComboBox x:Name="UpscalerPresetBox" FontSize="16" Width="280" Height="45" 
                                  Style="{StaticResource DarkComboBoxStyle}" 
                                  ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}" 
                                  SelectionChanged="Upscaler_SelectionChanged">
                            <ComboBoxItem Content="RAVU (Mid-Range GPUs)"/>
                            <ComboBoxItem Content="ArtCNN (High-End GPUs)"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" KeyboardNavigation.DirectionalNavigation="Continue">
                    <TextBlock Text="Saved Connections" FontSize="26" FontWeight="Bold" Margin="0,0,0,30"/>
                    
                    <ListBox x:Name="SavedServersList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Continue">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,15"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="12" Padding="2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="FocusRing" Property="BorderBrush" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E1E" CornerRadius="8" Padding="20">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"  Foreground="White" FontSize="18"/>
                                            <TextBlock Foreground="#B3B3B3" Margin="0,5,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="http://{0}:{1}">
                                                        <Binding Path="IpAddress"/>
                                                        <Binding Path="Port"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#006400" CornerRadius="5" Padding="10,5" 
                                                Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="ACTIVE" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>