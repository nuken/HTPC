<UserControl x:Class="HTPC.UI.Views.CollectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>

        <Style x:Key="NavPillStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource NavBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavPillActiveStyle" TargetType="Button" BasedOn="{StaticResource NavPillStyle}">
            <Setter Property="Background" Value="{DynamicResource ActiveNavBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ActiveNavTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="NavPillExitStyle" TargetType="Button" BasedOn="{StaticResource NavPillStyle}">
            <Setter Property="Background" Value="#8B0000"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="StandardFocusStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderThickness="3" BorderBrush="{DynamicResource PrimaryTextBrush}" CornerRadius="12" Margin="-3">
                            <Border.Effect><DropShadowEffect Color="White" BlurRadius="12" ShadowDepth="0" Opacity="0.8" /></Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,40,0,0" FocusManager.IsFocusScope="True" KeyboardNavigation.DirectionalNavigation="Continue">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="TopNavPanel" Grid.Row="0" Orientation="Horizontal" Margin="40,0,0,30" KeyboardNavigation.DirectionalNavigation="Continue" PreviewKeyDown="TopNavPanel_PreviewKeyDown">
            <Button Content="Home" Click="Home_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Guide" Click="Guide_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Multiview" Click="NavMultiview_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Movies" Click="Movies_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Collections" Style="{StaticResource NavPillActiveStyle}" Focusable="False"/>
            <Button Content="Recordings" Click="Recordings_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Shows" Click="Shows_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Videos" Click="Videos_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Settings" Click="Settings_Click" Style="{StaticResource NavPillStyle}"/>

            <!-- NEW THEME TOGGLE BUTTON -->
            <Button x:Name="ThemeToggleBtn" FontFamily="Segoe MDL2 Assets" Content="&#xE708;" FontSize="20" Click="ThemeToggleBtn_Click" Style="{StaticResource NavPillStyle}"/>
        </StackPanel>

        <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" ScrollViewer.PanningMode="VerticalOnly">
            <StackPanel Margin="0,0,0,60" KeyboardNavigation.DirectionalNavigation="Continue">

                <!-- MOVIE COLLECTIONS -->
                <StackPanel>
                    <TextBlock Text="Movie Collections" FontSize="24" FontWeight="Bold" Margin="40,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <ListBox x:Name="MovieCollectionsList" ItemsSource="{Binding MovieCollections}" PreviewMouseWheel="MainListBox_PreviewMouseWheel" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Continue">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="40,15,40,25"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,20,20"/>
                                <EventSetter Event="GotKeyboardFocus" Handler="CollectionCard_GotKeyboardFocus"/>
                                <EventSetter Event="MouseLeftButtonUp" Handler="CollectionCard_Click"/>
                                <EventSetter Event="PreviewKeyDown" Handler="CollectionCard_PreviewKeyDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="320" Height="180" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Cursor="Hand" ClipToBounds="True">
                                    <Border.Effect><DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/></Border.Effect>
                                    <Grid>
                                        <Image Source="{Binding ImageUrl, IsAsync=True}" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,320,180" RadiusX="12" RadiusY="12"/>
                                            </Image.Clip>
                                        </Image>
                                        <Border VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ContentCount, StringFormat='{}{0} Items'}" Foreground="#AAAAAA" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- TV SHOW COLLECTIONS -->
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="TV Show Collections" FontSize="24" FontWeight="Bold" Margin="40,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <ListBox x:Name="ShowCollectionsList" ItemsSource="{Binding ShowCollections}" PreviewMouseWheel="MainListBox_PreviewMouseWheel" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Continue">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="40,15,40,25"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,20,20"/>
                                <EventSetter Event="GotKeyboardFocus" Handler="CollectionCard_GotKeyboardFocus"/>
                                <EventSetter Event="MouseLeftButtonUp" Handler="CollectionCard_Click"/>
                                <EventSetter Event="PreviewKeyDown" Handler="CollectionCard_PreviewKeyDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="320" Height="180" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Cursor="Hand" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding ImageUrl, IsAsync=True}" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,320,180" RadiusX="12" RadiusY="12"/>
                                            </Image.Clip>
                                        </Image>
                                        <Border VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ContentCount, StringFormat='{}{0} Items'}" Foreground="#AAAAAA" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- CONTENT MODAL -->
        <Border x:Name="ContentModal" Grid.RowSpan="2" Background="{DynamicResource OverlayBackgroundBrush}" Visibility="Collapsed" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Padding="40" Panel.ZIndex="100">
            <Grid KeyboardNavigation.DirectionalNavigation="Cycle">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20" KeyboardNavigation.DirectionalNavigation="Continue">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="CloseModalBtn" Content="🔙 Back to Collections" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" FontSize="20" FontWeight="Bold" Cursor="Hand" Margin="0,0,30,0" Click="CloseModal_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}" PreviewKeyDown="CloseModalBtn_PreviewKeyDown"/>

                    <Button Grid.Column="1" x:Name="BingeMoviesBtn" Content="🍿 Binge Watch" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontSize="18" FontWeight="Bold" Cursor="Hand" Margin="0,0,30,0" Padding="15,8" Click="BingeMovies_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                        </Button.Resources>
                    </Button>

                    <TextBlock Grid.Column="2" x:Name="ModalTitle" Text="Collection Name" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,20,0"/>

                    <!-- UI UPDATED: Filter Buttons replacing ComboBoxes -->
                    <Button x:Name="CollectionSortBtn" Grid.Column="3" Width="180" Content="Alphabetical ▼"
                            Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" FontSize="16" FontWeight="SemiBold"
                            Click="CollectionSortBtn_Click" PreviewKeyDown="FilterBtn_PreviewKeyDown" FocusVisualStyle="{StaticResource StandardFocusStyle}" Margin="0,0,15,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>

                    <Button x:Name="CollectionOrderBtn" Grid.Column="4" Width="130" Content="Forward ▼"
                            Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" FontSize="16" FontWeight="SemiBold"
                            Click="CollectionOrderBtn_Click" PreviewKeyDown="FilterBtn_PreviewKeyDown" FocusVisualStyle="{StaticResource StandardFocusStyle}" Margin="0,0,20,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>

                    <!-- Collection Search Box -->
                    <Border Grid.Column="5" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="8" Padding="15,10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                        <Grid>
                            <TextBlock Text="Search collection..." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="16" IsHitTestVisible="False" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=CollectionSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="CollectionSearchBox" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" FontSize="16" CaretBrush="{DynamicResource PrimaryTextBrush}" TextChanged="CollectionSearchBox_TextChanged" PreviewKeyDown="CollectionSearchBox_PreviewKeyDown"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Lazy Loaded WrapPanel ListBox with Context Menu -->
                <ScrollViewer x:Name="ModalScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" ScrollViewer.PanningMode="VerticalOnly" ScrollChanged="ModalScroll_ScrollChanged">
                    <ListBox x:Name="CollectionContentList" PreviewMouseWheel="ModalListBox_PreviewMouseWheel" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Continue">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="0,15,40,25"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,20,30"/>
                                <EventSetter Event="GotKeyboardFocus" Handler="MediaCard_GotKeyboardFocus"/>
                                <EventSetter Event="MouseLeftButtonUp" Handler="MediaCard_Click"/>
                                <EventSetter Event="PreviewKeyDown" Handler="MediaCard_PreviewKeyDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="200" Height="300" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Cursor="Hand" ClipToBounds="True">

                                    <Border.ContextMenu>
                                        <ContextMenu Opened="ContextMenu_Opened">
                                            <MenuItem Header="Mark as Watched" Click="AdminCommand_Click" Tag="watch" FontSize="14" Padding="5"/>
                                            <MenuItem Header="Mark as Unwatched" Click="AdminCommand_Click" Tag="unwatch" FontSize="14" Padding="5"/>
                                            <MenuItem Header="Favorite" Click="AdminCommand_Click" Tag="favorite" FontSize="14" Padding="5"/>
                                            <MenuItem Header="Unfavorite" Click="AdminCommand_Click" Tag="unfavorite" FontSize="14" Padding="5"/>
                                            <Separator/>
                                            <MenuItem Header="Fix Timestamp" Click="AdminCommand_Click" Tag="retimestamp" FontSize="14" Padding="5"/>
                                            <MenuItem Header="Reprocess Video" Click="AdminCommand_Click" Tag="fingerprint" FontSize="14" Padding="5"/>
                                            <MenuItem Header="Refresh Metadata" Click="AdminCommand_Click" Tag="reprocess" FontSize="14" Padding="5"/>
                                            <MenuItem Header="Redetect Commercials" Click="AdminCommand_Click" Tag="recomskip" FontSize="14" Padding="5"/>
                                            <Separator/>
                                            <MenuItem Header="View Media Info" Click="MediaInfo_Click" FontSize="14" Padding="5" FontWeight="SemiBold"/>
                                            <Separator/>
                                            <MenuItem Header="Delete File" Click="AdminCommand_Click" Tag="delete" FontSize="14" Padding="5" FontWeight="Bold" Foreground="#FF4444"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid>
                                        <Image Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,200,300" RadiusX="12" RadiusY="12"/>
                                            </Image.Clip>
                                        </Image>
                                        <Border VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="EpisodesOverlay" Grid.RowSpan="2" Background="{DynamicResource OverlayBackgroundBrush}" Visibility="Collapsed" Panel.ZIndex="200" KeyboardNavigation.DirectionalNavigation="Continue">
            <!-- Episode Grid Content -->
            <Grid Margin="40" KeyboardNavigation.DirectionalNavigation="Continue">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,30,0" KeyboardNavigation.DirectionalNavigation="Continue">
                    <Button x:Name="CloseEpisodesBtn" Content="🔙 Back to Collection" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" FontSize="20" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,20" Click="CloseEpisodesOverlay_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}" PreviewKeyDown="EpisodesOverlayButtons_PreviewKeyDown"/>

                    <Button x:Name="BingeShowBtn" Content="🍿 Binge Watch" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontSize="18" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,20" Padding="15,8" Click="BingeShow_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}" PreviewKeyDown="EpisodesOverlayButtons_PreviewKeyDown">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                        </Button.Resources>
                    </Button>

                    <Border CornerRadius="12" ClipToBounds="True" Margin="0,0,0,20">
                        <Image x:Name="OverlayShowPoster" Width="270" Height="400" Stretch="UniformToFill">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,270,400" RadiusX="12" RadiusY="12"/>
                            </Image.Clip>
                        </Image>
                    </Border>

                    <TextBlock x:Name="OverlayShowTitle" Text="Show Title" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock x:Name="OverlayShowSummary" Text="Summary will appear here..." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="15" TextWrapping="Wrap" LineHeight="22" TextTrimming="CharacterEllipsis" MaxHeight="200"/>
                </StackPanel>

                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Margin="0,0,30,0" Padding="0,0,15,0" KeyboardNavigation.DirectionalNavigation="Continue">
                    <ListBox x:Name="SeasonsList" ItemsSource="{Binding Seasons}" Grid.Column="0" Background="Transparent" BorderThickness="0" SelectionChanged="SeasonsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" Margin="0,0,20,0" Width="120" KeyboardNavigation.DirectionalNavigation="Continue">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="15,10"/>
                                <Setter Property="Margin" Value="0,0,0,5"/>
                                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="FontSize" Value="18"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource StandardFocusStyle}"/>
                                <EventSetter Event="PreviewKeyDown" Handler="SeasonItem_PreviewKeyDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock><Run Text="Season "/><Run Text="{Binding Mode=OneWay}"/></TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <ListBox x:Name="EpisodesList" Grid.Column="2" ItemsSource="{Binding CurrentEpisodes}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Continue">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <EventSetter Event="MouseLeftButtonUp" Handler="EpisodeCard_Click"/>
                            <EventSetter Event="PreviewKeyDown" Handler="EpisodeItem_PreviewKeyDown"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Margin="0,0,20,20" Padding="15" Cursor="Hand">

                                <Border.ContextMenu>
                                    <ContextMenu Opened="ContextMenu_Opened">
                                        <MenuItem Header="Mark as Watched" Click="AdminCommand_Click" Tag="watch" FontSize="14" Padding="5"/>
                                        <MenuItem Header="Mark as Unwatched" Click="AdminCommand_Click" Tag="unwatch" FontSize="14" Padding="5"/>
                                        <MenuItem Header="Favorite" Click="AdminCommand_Click" Tag="favorite" FontSize="14" Padding="5"/>
                                        <MenuItem Header="Unfavorite" Click="AdminCommand_Click" Tag="unfavorite" FontSize="14" Padding="5"/>
                                        <Separator/>
                                        <MenuItem Header="Fix Timestamp" Click="AdminCommand_Click" Tag="retimestamp" FontSize="14" Padding="5"/>
                                        <MenuItem Header="Reprocess Video" Click="AdminCommand_Click" Tag="fingerprint" FontSize="14" Padding="5"/>
                                        <MenuItem Header="Refresh Metadata" Click="AdminCommand_Click" Tag="reprocess" FontSize="14" Padding="5"/>
                                        <MenuItem Header="Redetect Commercials" Click="AdminCommand_Click" Tag="recomskip" FontSize="14" Padding="5"/>
                                        <Separator/>
                                        <MenuItem Header="View Media Info" Click="MediaInfo_Click" FontSize="14" Padding="5" FontWeight="SemiBold"/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Border.Effect><DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="6" Opacity="0.3"/></Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Image Source="{Binding PosterUrl, IsAsync=True}" Width="220" Height="124" Stretch="UniformToFill">
                                            <Image.Clip><RectangleGeometry Rect="0,0,220,124" RadiusX="8" RadiusY="8"/></Image.Clip>
                                        </Image>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8">
                                            <TextBlock Text="♥" Foreground="#D32F2F" FontSize="20" Margin="0,0,5,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Background="#00A4EF" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWatched}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="✓" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="20,5,20,0">
                                        <TextBlock Text="{Binding CurrentShowTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="14" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,5,0,10">
                                            <Run Text="Episode "/><Run Text="{Binding EpisodeNumber, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="{DynamicResource NavBackgroundBrush}" CornerRadius="25" Width="50" Height="50" VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="▶" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border x:Name="BingeChoiceOverlay" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="300">
            <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="450">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="10" Opacity="0.8"/>
                </Border.Effect>
                <StackPanel KeyboardNavigation.DirectionalNavigation="Continue">
                    <TextBlock Text="Binge Watch Options" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="26" FontWeight="Bold" Margin="0,0,0,25" HorizontalAlignment="Center"/>

                    <Button x:Name="BingeResumeBtn" Content="▶ Resume Where I Left Off" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontSize="18" FontWeight="Bold" Cursor="Hand" Margin="0,0,0,15" Padding="20,12" Click="BingeResume_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}" PreviewKeyDown="BingeChoice_PreviewKeyDown">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>

                    <Button x:Name="BingeBeginningBtn" Content="⏪ Start from the Beginning" Background="{DynamicResource NavBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" FontSize="18" FontWeight="Bold" Cursor="Hand" Margin="0,0,0,15" Padding="20,12" Click="BingeBeginning_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}" PreviewKeyDown="BingeChoice_PreviewKeyDown">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>

                    <Button x:Name="BingeCancelBtn" Content="Cancel" Background="Transparent" Foreground="{DynamicResource SecondaryTextBrush}" BorderThickness="0" FontSize="18" FontWeight="SemiBold" Cursor="Hand" Padding="20,12" Click="BingeCancel_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}" PreviewKeyDown="BingeChoice_PreviewKeyDown"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Toast Notification -->
        <Border x:Name="ToastNotification" Grid.RowSpan="2" Background="#D800A4EF" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,50" Padding="20,10" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="500">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
        </Border>

        <!-- Media Info Modal -->
        <Border x:Name="MediaInfoModal" Grid.RowSpan="2" Background="{DynamicResource PanelBackgroundBrush}" Visibility="Collapsed" Padding="40" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="500" MaxWidth="800" Panel.ZIndex="500">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Media Information" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,20"/>
                <TextBlock x:Name="MediaInfoTitle" Grid.Row="1" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,15" TextWrapping="Wrap"/>

                <StackPanel x:Name="MediaInfoDetails" Grid.Row="2" Margin="0,0,0,30"/>

                <Button Grid.Row="3" Content="Close" Width="120" Height="40" Background="{DynamicResource NavBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" BorderThickness="0" Cursor="Hand" Click="CloseMediaInfo_Click" HorizontalAlignment="Right" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>
            </Grid>
        </Border>

        <!-- NEW: FILTER SELECTION OVERLAY -->
        <Border x:Name="FilterOverlay" Grid.RowSpan="2" Background="{DynamicResource OverlayBackgroundBrush}" Visibility="Collapsed" Panel.ZIndex="600">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="FilterOverlayTitle" Text="Select Option" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <ListBox x:Name="FilterSelectionList" Grid.Row="1" MaxHeight="500" MinWidth="350" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="FilterSelectionList_PreviewKeyDown"
                         MouseLeftButtonUp="FilterSelectionList_MouseUp">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="20,15"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{StaticResource StandardFocusStyle}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="2">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
