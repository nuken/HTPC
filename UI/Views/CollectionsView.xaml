<UserControl x:Class="HTPC.UI.Views.CollectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F0F0F" Foreground="White"
			 PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <Style x:Key="NavPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#B3B3B3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#333333"/>
                            </Trigger>
                            
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#444444"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="White"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavPillActiveStyle" TargetType="Button" BasedOn="{StaticResource NavPillStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        
        <Style x:Key="NavPillExitStyle" TargetType="Button" BasedOn="{StaticResource NavPillStyle}">
            <Setter Property="Background" Value="#8B0000"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="StandardFocusStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderThickness="3" BorderBrush="White" CornerRadius="12" Margin="-3">
                            <Border.Effect><DropShadowEffect Color="White" BlurRadius="12" ShadowDepth="0" Opacity="0.8" /></Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,40,0,0" FocusManager.IsFocusScope="True" KeyboardNavigation.DirectionalNavigation="Continue">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="TopNavPanel" Grid.Row="0" Orientation="Horizontal" Margin="40,0,0,30" KeyboardNavigation.DirectionalNavigation="Continue" PreviewKeyDown="TopNavPanel_PreviewKeyDown">            <Button Content="Home" Click="Home_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Guide" Click="Guide_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Multiview" Click="NavMultiview_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Movies" Click="Movies_Click" Style="{StaticResource NavPillStyle}"/>
            
            <Button Content="Collections" Style="{StaticResource NavPillActiveStyle}" Focusable="False"/>
            
            <Button Content="Recordings" Click="Recordings_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Shows" Click="Shows_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Videos" Click="Videos_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Settings" Click="Settings_Click" Style="{StaticResource NavPillStyle}"/>
            
        </StackPanel>

        <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" ScrollViewer.PanningMode="VerticalOnly">
            <StackPanel Margin="0,0,0,60" KeyboardNavigation.DirectionalNavigation="Continue">
                
                <StackPanel>
                    <TextBlock Text="Movie Collections" FontSize="24" FontWeight="Bold" Margin="40,0,0,10"/>
                    <ListBox x:Name="MovieCollectionsList" ItemsSource="{Binding MovieCollections}" Focusable="False" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Continue" ScrollViewer.PanningMode="HorizontalOnly">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" Margin="40,15,40,25"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Margin" Value="0,0,20,0"/>
                                <EventSetter Event="UIElement.GotKeyboardFocus" Handler="CollectionCard_GotKeyboardFocus"/>
                                <EventSetter Event="MouseLeftButtonUp" Handler="CollectionCard_Click"/>
                                <EventSetter Event="PreviewKeyDown" Handler="CollectionCard_PreviewKeyDown"/>
								<Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="White"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="320" Height="180" Background="#1E1E1E" CornerRadius="12" Cursor="Hand" ClipToBounds="True">
                                    <Border.Effect><DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/></Border.Effect>
                                    <Grid>
                                        <Image Source="{Binding ImageUrl, IsAsync=True}" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,320,180" RadiusX="12" RadiusY="12"/>
                                            </Image.Clip>
                                        </Image>
                                        <Border VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ContentCount, StringFormat='{}{0} Items'}" Foreground="#AAAAAA" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="TV Show Collections" FontSize="24" FontWeight="Bold" Margin="40,0,0,10"/>
                    <ListBox x:Name="ShowCollectionsList" ItemsSource="{Binding ShowCollections}" Focusable="False" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Continue" ScrollViewer.PanningMode="HorizontalOnly">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" Margin="40,15,40,25"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Margin" Value="0,0,20,0"/>
                                <EventSetter Event="UIElement.GotKeyboardFocus" Handler="CollectionCard_GotKeyboardFocus"/>
                                <EventSetter Event="MouseLeftButtonUp" Handler="CollectionCard_Click"/>
                                <EventSetter Event="PreviewKeyDown" Handler="CollectionCard_PreviewKeyDown"/>
								<Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2"><ContentPresenter/></Border>
                                            <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="320" Height="180" Background="#1E1E1E" CornerRadius="12" Cursor="Hand" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding ImageUrl, IsAsync=True}" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,320,180" RadiusX="12" RadiusY="12"/>
                                            </Image.Clip>
                                        </Image>
                                        <Border VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ContentCount, StringFormat='{}{0} Items'}" Foreground="#AAAAAA" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="ContentModal" Grid.RowSpan="2" Background="#F20A0A0A" Visibility="Collapsed" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Padding="40" Panel.ZIndex="100">
            <Grid KeyboardNavigation.DirectionalNavigation="Cycle">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20" KeyboardNavigation.DirectionalNavigation="Continue">
    <Button x:Name="CloseModalBtn" Content="🔙 Back to Collections" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="20" FontWeight="Bold" Cursor="Hand" Margin="0,0,30,0" Click="CloseModal_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>
    
    <Button x:Name="BingeMoviesBtn" Content="🍿 Binge Watch" Background="#00A4EF" Foreground="White" BorderThickness="0" FontSize="18" FontWeight="Bold" Cursor="Hand" Margin="0,0,30,0" Padding="15,8" Click="BingeMovies_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}">
        <Button.Resources>
            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
        </Button.Resources>
    </Button>
    
    <TextBlock x:Name="ModalTitle" Text="Collection Name" FontSize="36" FontWeight="Bold" VerticalAlignment="Center"/>
</StackPanel>
                
                <ListBox x:Name="CollectionContentList" Grid.Row="1" Focusable="False" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.PanningMode="HorizontalOnly">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" Margin="0,15,40,25"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Margin" Value="0,0,20,0"/>
                            <EventSetter Event="UIElement.GotKeyboardFocus" Handler="MediaCard_GotKeyboardFocus"/>
                            <EventSetter Event="MouseLeftButtonUp" Handler="MediaCard_Click"/>
                            <EventSetter Event="PreviewKeyDown" Handler="MediaCard_PreviewKeyDown"/>
                            <Setter Property="Template">
    <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="FocusRing" Property="BorderBrush" Value="White"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Setter.Value>
</Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200" Height="300" Background="#1E1E1E" CornerRadius="12" Cursor="Hand" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,200,300" RadiusX="12" RadiusY="12"/>
                                        </Image.Clip>
                                    </Image>
                                    <Border VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
		
		<Border x:Name="EpisodesOverlay" Grid.RowSpan="2" Background="#F20A0A0A" Visibility="Collapsed" Panel.ZIndex="200" KeyboardNavigation.DirectionalNavigation="Continue">
            <Grid Margin="40" KeyboardNavigation.DirectionalNavigation="Continue">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/> 
                    <ColumnDefinition Width="200"/> 
                    <ColumnDefinition Width="*"/>   
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,30,0" KeyboardNavigation.DirectionalNavigation="Continue">
   <Button x:Name="CloseEpisodesBtn" Content="🔙 Back to Collection" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="20" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,20" Click="CloseEpisodesOverlay_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}" PreviewKeyDown="EpisodesOverlayButtons_PreviewKeyDown"/>
    
    <Button x:Name="BingeShowBtn" Content="🍿 Binge Watch" Background="#00A4EF" Foreground="White" BorderThickness="0" FontSize="18" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,20" Padding="15,8" Click="BingeShow_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}" PreviewKeyDown="EpisodesOverlayButtons_PreviewKeyDown">
        <Button.Resources>
            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
        </Button.Resources>
    </Button>
    
    <Border CornerRadius="12" ClipToBounds="True" Margin="0,0,0,20">
        <Image x:Name="OverlayShowPoster" Width="270" Height="400" Stretch="UniformToFill">
            <Image.Clip>
                <RectangleGeometry Rect="0,0,270,400" RadiusX="12" RadiusY="12"/>
            </Image.Clip>
        </Image>
    </Border>
                    
                    <TextBlock x:Name="OverlayShowTitle" Text="Show Title" Foreground="White" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock x:Name="OverlayShowSummary" Text="Summary will appear here..." Foreground="#AAAAAA" FontSize="15" TextWrapping="Wrap" LineHeight="22" TextTrimming="CharacterEllipsis" MaxHeight="200"/>
                </StackPanel>

                <Border Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,1,0" Margin="0,0,30,0" Padding="0,0,15,0" KeyboardNavigation.DirectionalNavigation="Continue">
                    <ListBox x:Name="SeasonsList" ItemsSource="{Binding Seasons}" Grid.Column="0" Background="Transparent" BorderThickness="0" SelectionChanged="SeasonsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" Margin="0,0,20,0" Width="120" KeyboardNavigation.DirectionalNavigation="Continue">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="15,10"/>
                                <Setter Property="Margin" Value="0,0,0,5"/>
                                <Setter Property="Background" Value="#1A1A1A"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontSize" Value="18"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource StandardFocusStyle}"/>
                                <EventSetter Event="PreviewKeyDown" Handler="SeasonItem_PreviewKeyDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#333333"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#444444"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter TargetName="bg" Property="BorderBrush" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock><Run Text="Season "/><Run Text="{Binding Mode=OneWay}"/></TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <ListBox x:Name="EpisodesList" Grid.Column="2" ItemsSource="{Binding CurrentEpisodes}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Continue">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <EventSetter Event="MouseLeftButtonUp" Handler="EpisodeCard_Click"/>
                            <EventSetter Event="PreviewKeyDown" Handler="EpisodeItem_PreviewKeyDown"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1A1A1A" CornerRadius="12" Margin="0,0,20,20" Padding="15" Cursor="Hand">
                                <Border.Effect><DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="6" Opacity="0.3"/></Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Grid Grid.Column="0">
                                        <Image Source="{Binding PosterUrl, IsAsync=True}" Width="220" Height="124" Stretch="UniformToFill">
                                            <Image.Clip><RectangleGeometry Rect="0,0,220,124" RadiusX="8" RadiusY="8"/></Image.Clip>
                                        </Image>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8">
                                            <Border Background="#00A4EF" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsWatched}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="✓" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="20,5,20,0">
                                        <TextBlock Text="{Binding CurrentShowTitle}" FontSize="20" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="14" Foreground="#00A4EF" FontWeight="SemiBold" Margin="0,5,0,10">
                                            <Run Text="Episode "/><Run Text="{Binding EpisodeNumber, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" FontSize="14" Foreground="#AAAAAA" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="#2A2A2A" CornerRadius="25" Width="50" Height="50" VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="▶" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
		<!-- NEW: BINGE WATCH SMART PROMPT -->
        <Border x:Name="BingeChoiceOverlay" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="300">
            <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" CornerRadius="16" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="450">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="10" Opacity="0.8"/>
                </Border.Effect>
                <StackPanel KeyboardNavigation.DirectionalNavigation="Continue">
                    <TextBlock Text="Binge Watch Options" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,0,0,25" HorizontalAlignment="Center"/>
                    
                    <Button x:Name="BingeResumeBtn" Content="▶ Resume Where I Left Off" Background="#00A4EF" Foreground="White" BorderThickness="0" FontSize="18" FontWeight="Bold" Cursor="Hand" Margin="0,0,0,15" Padding="20,12" Click="BingeResume_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}" PreviewKeyDown="BingeChoice_PreviewKeyDown">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                    
                    <Button x:Name="BingeBeginningBtn" Content="⏪ Start from the Beginning" Background="#333333" Foreground="White" BorderThickness="0" FontSize="18" FontWeight="Bold" Cursor="Hand" Margin="0,0,0,15" Padding="20,12" Click="BingeBeginning_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}" PreviewKeyDown="BingeChoice_PreviewKeyDown">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>

                    <Button x:Name="BingeCancelBtn" Content="Cancel" Background="Transparent" Foreground="#AAAAAA" BorderThickness="0" FontSize="18" FontWeight="SemiBold" Cursor="Hand" Padding="20,12" Click="BingeCancel_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}" PreviewKeyDown="BingeChoice_PreviewKeyDown"/>
                </StackPanel>
            </Border>
        </Border>
		
    </Grid>
</UserControl>