<UserControl x:Class="HTPC.UI.Views.ShowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F0F0F" Foreground="White">

    <UserControl.Resources>
        
        <Style x:Key="NavPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#B3B3B3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#444444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavPillActiveStyle" TargetType="Button" BasedOn="{StaticResource NavPillStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Focusable" Value="False"/> 
        </Style>

        <Style x:Key="StandardFocusStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderThickness="2" BorderBrush="White" CornerRadius="8" Margin="-2">
                            <Border.Effect>
                                <DropShadowEffect Color="White" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource StandardFocusStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="BgBorder" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="15,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Fill="#B3B3B3" Data="M 0 0 L 5 5 L 10 0 Z" VerticalAlignment="Center" Margin="15,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BgBorder" Property="Background" Value="#2A2A2A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="15,10,35,10" VerticalAlignment="Center" TextElement.Foreground="White"
                                              Content="{TemplateBinding SelectionBoxItem}" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="#1A1A1A" CornerRadius="8" Margin="0,5,0,0" MinWidth="{TemplateBinding ActualWidth}" Padding="0,5">
                                    <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,40,0,0" FocusManager.IsFocusScope="True" 
          KeyboardNavigation.DirectionalNavigation="Continue" 
          KeyboardNavigation.TabNavigation="Cycle">
        
        <Grid x:Name="MasterShowsGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="40,0,0,30" KeyboardNavigation.DirectionalNavigation="Continue">
                <Button Content="Home" Click="Home_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Guide" Click="Guide_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Movies" Click="Movies_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Shows" Style="{StaticResource NavPillActiveStyle}"/>
                <Button Content="Videos" Click="Videos_Click" Style="{StaticResource NavPillStyle}"/>
                <Button Content="Settings" Click="Settings_Click" Style="{StaticResource NavPillStyle}"/>
            </StackPanel>

            <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="MainScroll_ScrollChanged" Focusable="False">
                <StackPanel Margin="0,0,0,60" KeyboardNavigation.DirectionalNavigation="Continue">
                    
                    <Grid Margin="40,0,40,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="8" Padding="15,10" Margin="0,0,20,0" BorderThickness="1" BorderBrush="#333333" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                            <TextBox x:Name="SearchBox" PreviewKeyDown="SearchBox_PreviewKeyDown" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="16" CaretBrush="White" TextChanged="SearchBox_TextChanged"/>
                        </Border>
                        <TextBlock Text="Search TV Shows..." Foreground="#555555" FontSize="16" IsHitTestVisible="False" Margin="15,12,0,0" VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ComboBox x:Name="SortDropdown" PreviewKeyDown="Dropdown_PreviewKeyDown" Grid.Column="1" Width="220" FontSize="16" FontWeight="SemiBold" SelectionChanged="SortDropdown_SelectionChanged">
                            <ComboBoxItem Content="Recently Recorded" IsSelected="True"/>
                            <ComboBoxItem Content="Alphabetical (A-Z)"/>
                            <ComboBoxItem Content="Alphabetical (Z-A)"/>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="15,10"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter Property="Background" Value="#404040"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </Grid>

                    <ListBox x:Name="ShowsGrid" ItemsSource="{Binding ShowLibrary}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             PreviewMouseWheel="ShowsGrid_PreviewMouseWheel" KeyboardNavigation.DirectionalNavigation="Continue">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="40,0,0,0" KeyboardNavigation.DirectionalNavigation="Continue"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,20,30"/>
                                <EventSetter Event="MouseLeftButtonUp" Handler="ShowCard_Click"/>
                                <EventSetter Event="PreviewKeyDown" Handler="ListBoxItem_PreviewKeyDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="FocusRing" Property="BorderBrush" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="200" Height="300" Background="#1E1E1E" CornerRadius="12" Cursor="Hand">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Image Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill" ClipToBounds="True">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,200,300" RadiusX="12" RadiusY="12"/>
                                            </Image.Clip>
                                        </Image>
                                        <Border VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border x:Name="EpisodesOverlay" Background="#F20A0A0A" Visibility="Collapsed" Margin="0,-40,0,0" KeyboardNavigation.DirectionalNavigation="Continue">
            <Grid Margin="40" KeyboardNavigation.DirectionalNavigation="Continue">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/> 
                    <ColumnDefinition Width="200"/> 
                    <ColumnDefinition Width="*"/>   
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,30,0" KeyboardNavigation.DirectionalNavigation="Continue">
                    <Button Content="🔙 Back to Shows" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="20" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,20" Click="CloseOverlay_Click" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>
                    
                    <Border CornerRadius="12" ClipToBounds="True" Margin="0,0,0,20">
                        <Image x:Name="OverlayShowPoster" Width="270" Height="400" Stretch="UniformToFill"/>
                    </Border>
                    
                    <TextBlock x:Name="OverlayShowTitle" Text="Show Title" Foreground="White" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock x:Name="OverlayShowSummary" Text="Summary will appear here..." Foreground="#AAAAAA" FontSize="15" TextWrapping="Wrap" LineHeight="22" TextTrimming="CharacterEllipsis" MaxHeight="200"/>
                </StackPanel>

                <Border Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,1,0" Margin="0,0,30,0" Padding="0,0,15,0" KeyboardNavigation.DirectionalNavigation="Continue">
                    <ListBox x:Name="SeasonsList" ItemsSource="{Binding Seasons}" Background="Transparent" BorderThickness="0" SelectionChanged="SeasonsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="20,15"/>
                                <Setter Property="Margin" Value="0,0,0,5"/>
                                <Setter Property="FontSize" Value="18"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#333333"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#222222"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#444444"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter TargetName="bg" Property="BorderBrush" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="Season "/>
                                    <Run Text="{Binding Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <ListBox x:Name="EpisodesList" Grid.Column="2" ItemsSource="{Binding CurrentEpisodes}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Continue">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <EventSetter Event="MouseLeftButtonUp" Handler="EpisodeCard_Click"/>
                            <EventSetter Event="PreviewKeyDown" Handler="EpisodeItem_PreviewKeyDown"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1A1A1A" CornerRadius="12" Margin="0,0,20,20" Padding="15" Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="6" Opacity="0.3"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Image Grid.Column="0" Source="{Binding PosterUrl, IsAsync=True}" Width="220" Height="124" Stretch="UniformToFill">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,220,124" RadiusX="8" RadiusY="8"/>
                                        </Image.Clip>
                                    </Image>

                                    <StackPanel Grid.Column="1" Margin="20,5,20,0">
                                        <TextBlock Text="{Binding CurrentShowTitle}" FontSize="20" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="14" Foreground="#00A4EF" FontWeight="SemiBold" Margin="0,5,0,10">
                                            <Run Text="Episode "/>
                                            <Run Text="{Binding EpisodeNumber, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" FontSize="14" Foreground="#AAAAAA" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="#2A2A2A" CornerRadius="25" Width="50" Height="50" VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="▶" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>