<UserControl x:Class="HTPC.UI.Views.MoviesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F0F0F" Foreground="White">

    <UserControl.Resources>
        
        <Style x:Key="NavPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#B3B3B3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#444444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavPillActiveStyle" TargetType="Button" BasedOn="{StaticResource NavPillStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Focusable" Value="False"/> 
        </Style>

        <Style x:Key="StandardFocusStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderThickness="2" BorderBrush="White" CornerRadius="8" Margin="-2">
                            <Border.Effect>
                                <DropShadowEffect Color="White" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GenrePillStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#B3B3B3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Genres"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="20,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#88FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource StandardFocusStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="BgBorder" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="15,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Fill="#B3B3B3" Data="M 0 0 L 5 5 L 10 0 Z" VerticalAlignment="Center" Margin="15,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BgBorder" Property="Background" Value="#2A2A2A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="15,10,35,10" VerticalAlignment="Center" TextElement.Foreground="White"
                                              Content="{TemplateBinding SelectionBoxItem}" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="#1A1A1A" CornerRadius="8" Margin="0,5,0,0" MinWidth="{TemplateBinding ActualWidth}" Padding="0,5">
                                    <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,40,0,0" FocusManager.IsFocusScope="True" 
          KeyboardNavigation.DirectionalNavigation="Continue" 
          KeyboardNavigation.TabNavigation="Cycle">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="40,0,0,30" KeyboardNavigation.DirectionalNavigation="Continue">
            <Button Content="Home" Click="Home_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Guide" Click="Guide_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Movies" Style="{StaticResource NavPillActiveStyle}"/>
            <Button Content="Shows" Click="Shows_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Videos" Click="Videos_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Settings" Click="Settings_Click" Style="{StaticResource NavPillStyle}"/>
        </StackPanel>

        <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="MainScroll_ScrollChanged" Focusable="False">
            <StackPanel Margin="0,0,0,60" KeyboardNavigation.DirectionalNavigation="Continue">
                
                <Grid Margin="40,0,40,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="8" Padding="15,10" Margin="0,0,20,0" BorderThickness="1" BorderBrush="#333333" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                        <TextBox x:Name="SearchBox" PreviewKeyDown="SearchBox_PreviewKeyDown" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="16" 
                                 CaretBrush="White" TextChanged="SearchBox_TextChanged"/>
                    </Border>
                    <TextBlock Text="Search movies, cast, or directors..." Foreground="#555555" FontSize="16" IsHitTestVisible="False" Margin="15,12,0,0" VerticalAlignment="Top">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    
                    <ComboBox x:Name="StatusDropdown" PreviewKeyDown="Dropdown_PreviewKeyDown" Grid.Column="1" Width="180" FontSize="16" FontWeight="SemiBold" SelectionChanged="StatusDropdown_SelectionChanged" Margin="0,0,15,0">
                        <ComboBoxItem Content="All Movies" IsSelected="True"/>
                        <ComboBoxItem Content="Favorites"/>
                        <ComboBoxItem Content="Watched"/>
                        <ComboBoxItem Content="Unwatched"/>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="15,10"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter Property="Background" Value="#404040"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <ComboBox x:Name="SortDropdown" PreviewKeyDown="Dropdown_PreviewKeyDown" Grid.Column="2" Width="220" FontSize="16" FontWeight="SemiBold" SelectionChanged="SortDropdown_SelectionChanged">
                        <ComboBoxItem Content="Recently Added"/>
                        <ComboBoxItem Content="Alphabetical (A-Z)"/>
                        <ComboBoxItem Content="Alphabetical (Z-A)"/>
                        <ComboBoxItem Content="Release Year (Newest)"/>
                        <ComboBoxItem Content="Release Year (Oldest)"/>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="15,10"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter Property="Background" Value="#404040"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                </Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="40,0,0,30" Focusable="False">
                    <StackPanel x:Name="GenrePanel" Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Continue">
                        <RadioButton Content="All" Style="{StaticResource GenrePillStyle}" IsChecked="True" Checked="Genre_Checked" PreviewKeyDown="GenrePill_PreviewKeyDown"/>
                        <RadioButton Content="Action" Style="{StaticResource GenrePillStyle}" Checked="Genre_Checked" PreviewKeyDown="GenrePill_PreviewKeyDown"/>
                        <RadioButton Content="Comedy" Style="{StaticResource GenrePillStyle}" Checked="Genre_Checked" PreviewKeyDown="GenrePill_PreviewKeyDown"/>
                        <RadioButton Content="Drama" Style="{StaticResource GenrePillStyle}" Checked="Genre_Checked" PreviewKeyDown="GenrePill_PreviewKeyDown"/>
                        <RadioButton Content="Family" Style="{StaticResource GenrePillStyle}" Checked="Genre_Checked" PreviewKeyDown="GenrePill_PreviewKeyDown"/>
                        <RadioButton Content="Sci-Fi" Style="{StaticResource GenrePillStyle}" Checked="Genre_Checked" PreviewKeyDown="GenrePill_PreviewKeyDown"/>
                        <RadioButton Content="Horror" Style="{StaticResource GenrePillStyle}" Checked="Genre_Checked" PreviewKeyDown="GenrePill_PreviewKeyDown"/>
                        <RadioButton Content="Documentary" Style="{StaticResource GenrePillStyle}" Checked="Genre_Checked" PreviewKeyDown="GenrePill_PreviewKeyDown"/>
                    </StackPanel>
                </ScrollViewer>
                
                <ListBox x:Name="MoviesGrid" ItemsSource="{Binding MovieLibrary}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         PreviewMouseWheel="MoviesGrid_PreviewMouseWheel" KeyboardNavigation.DirectionalNavigation="Continue">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Margin="40,0,0,0" KeyboardNavigation.DirectionalNavigation="Continue"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,20,30"/>
                            <EventSetter Event="MouseLeftButtonUp" Handler="MovieCard_Click"/>
                            <EventSetter Event="PreviewKeyDown" Handler="ListBoxItem_PreviewKeyDown"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="16" Padding="2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200" Height="300" Background="#1E1E1E" CornerRadius="12" Cursor="Hand">
                                
                                <Border.ContextMenu>
                                    <ContextMenu Opened="ContextMenu_Opened">
                                        <MenuItem Header="Mark as Watched" Click="AdminCommand_Click" Tag="watch" FontSize="14" Padding="5"/>
                                        <MenuItem Header="Mark as Unwatched" Click="AdminCommand_Click" Tag="unwatch" FontSize="14" Padding="5"/>
                                        <MenuItem Header="Favorite" Click="AdminCommand_Click" Tag="favorite" FontSize="14" Padding="5"/>
                                        <MenuItem Header="Unfavorite" Click="AdminCommand_Click" Tag="unfavorite" FontSize="14" Padding="5"/>
                                        <Separator/>
                                        <MenuItem Header="Fix Timestamp" Click="AdminCommand_Click" Tag="retimestamp" FontSize="14" Padding="5"/>
                                        <MenuItem Header="Reprocess Video" Click="AdminCommand_Click" Tag="fingerprint" FontSize="14" Padding="5"/>
                                        <MenuItem Header="Refresh Metadata" Click="AdminCommand_Click" Tag="reprocess" FontSize="14" Padding="5"/>
                                        <MenuItem Header="Redetect Commercials" Click="AdminCommand_Click" Tag="recomskip" FontSize="14" Padding="5"/>
                                        <Separator/>
                                        <MenuItem Header="View Media Info" Click="MediaInfo_Click" FontSize="14" Padding="5" FontWeight="SemiBold"/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/>
                                </Border.Effect>
                                <Grid>
                                    <Image Source="{Binding PosterUrl, IsAsync=True}" Stretch="UniformToFill" ClipToBounds="True">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,200,300" RadiusX="12" RadiusY="12"/>
                                        </Image.Clip>
                                    </Image>
                                    <Border VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="12" CornerRadius="0,0,12,12">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="LoadingText" Text="Loading..." Foreground="#888888" FontSize="16" HorizontalAlignment="Center" Margin="0,20" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="ToastNotification" Grid.RowSpan="2" Background="#D800A4EF" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,50" Padding="20,10" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
        </Border>

        <Border x:Name="MediaInfoModal" Grid.RowSpan="2" Background="#F20A0A0A" Visibility="Collapsed" Padding="40" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="500" MaxWidth="800">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="Media Information" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
                
                <TextBlock x:Name="MediaInfoTitle" Grid.Row="1" FontSize="18" FontWeight="SemiBold" Foreground="#00A4EF" Margin="0,0,0,15" TextWrapping="Wrap"/>
                
                <StackPanel x:Name="MediaInfoDetails" Grid.Row="2" Margin="0,0,0,30">
                    </StackPanel>

                <Button Grid.Row="3" Content="Close" Width="120" Height="40" Background="#333333" Foreground="White" FontWeight="SemiBold" FontSize="16" BorderThickness="0" Cursor="Hand" Click="CloseMediaInfo_Click" HorizontalAlignment="Right" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>