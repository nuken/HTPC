<UserControl x:Class="HTPC.UI.Views.MultiviewSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F0F0F" Foreground="White"
             Focusable="True">

    <UserControl.Resources>
        <Style x:Key="StandardFocusStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderThickness="2" BorderBrush="White" CornerRadius="6" Margin="-2">
                            <Border.Effect>
                                <DropShadowEffect Color="White" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChannelCardStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,15,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource StandardFocusStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
		
		 <Style x:Key="NavPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#B3B3B3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#444444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavPillActiveStyle" TargetType="Button" BasedOn="{StaticResource NavPillStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Focusable" Value="False"/> 
        </Style>

        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource StandardFocusStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,30" KeyboardNavigation.DirectionalNavigation="Continue">
            <Button Content="Home" Click="Home_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Guide" Click="Guide_Click" Style="{StaticResource NavPillStyle}"/>
            
            <Button Content="Multiview" Style="{StaticResource NavPillActiveStyle}"/>
            
            <Button Content="Movies" Click="Movies_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Shows" Click="Shows_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Videos" Click="Videos_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Settings" Click="Settings_Click" Style="{StaticResource NavPillStyle}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#141414" CornerRadius="12" Padding="20" Margin="0,0,30,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="1. Select Live Channels" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <ComboBox x:Name="CollectionDropdown" Grid.Row="1" Width="250" HorizontalAlignment="Left" FontSize="16" FontWeight="Bold" Margin="0,0,0,20" Height="45"
                              SelectionChanged="CollectionDropdown_SelectionChanged" FocusVisualStyle="{StaticResource StandardFocusStyle}">
                    </ComboBox>

                    <ListBox x:Name="ChannelItemsControl" Grid.Row="2" Background="Transparent" BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                             ScrollViewer.CanContentScroll="False" 
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChannelCardStyle}" Click="Channel_Click" Tag="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border Grid.Column="0" Background="#474747" CornerRadius="8" Margin="0,0,15,0" Width="100" Height="75" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="{Binding Number}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="#2A2A2A"/>
                                                <Image Source="{Binding ImageUrl}" Stretch="Uniform" Margin="10"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Background="#333333" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="#00A4EF"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CurrentAirings[0].DisplayTitle}" FontSize="18" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding CurrentAirings[0].DisplaySummary}" FontSize="13" Foreground="#AAAAAA" TextTrimming="CharacterEllipsis" MaxHeight="38" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#141414" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="2. Selected Screens" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                    
                    <Border Background="#1A1A1A" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock x:Name="Slot1Text" Text="Slot 1: Empty" FontSize="16" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                            <Button x:Name="RemoveSlot1" Content="❌" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="#FF4444" FontSize="14" Cursor="Hand" Visibility="Collapsed" Click="RemoveSlot_Click" Tag="0" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>
                        </Grid>
                    </Border>
                    
                    <Border Background="#1A1A1A" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock x:Name="Slot2Text" Text="Slot 2: Empty" FontSize="16" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                            <Button x:Name="RemoveSlot2" Content="❌" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="#FF4444" FontSize="14" Cursor="Hand" Visibility="Collapsed" Click="RemoveSlot_Click" Tag="1" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>
                        </Grid>
                    </Border>
                     
                    <Border Background="#1A1A1A" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock x:Name="Slot3Text" Text="Slot 3: Empty" FontSize="16" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                            <Button x:Name="RemoveSlot3" Content="❌" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="#FF4444" FontSize="14" Cursor="Hand" Visibility="Collapsed" Click="RemoveSlot_Click" Tag="2" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>
                        </Grid>
                    </Border>
                     
                    <Border Background="#1A1A1A" CornerRadius="8" Padding="15" Margin="0,0,0,30">
                        <Grid>
                            <TextBlock x:Name="Slot4Text" Text="Slot 4: Empty" FontSize="16" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                            <Button x:Name="RemoveSlot4" Content="❌" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="#FF4444" FontSize="14" Cursor="Hand" Visibility="Collapsed" Click="RemoveSlot_Click" Tag="3" FocusVisualStyle="{StaticResource StandardFocusStyle}"/>
                        </Grid>
                    </Border>

                    <Button x:Name="LaunchButton" Content="▶ LAUNCH MULTIVIEW" FontSize="20" FontWeight="Bold" Padding="20" Background="#8B0000" Foreground="White" Cursor="Hand" Click="Launch_Click" IsEnabled="False" Style="{StaticResource ActionBtnStyle}"/>
                    <Button x:Name="ClearButton" Content="Clear All" FontSize="16" Margin="0,15,0,0" Padding="10" Background="Transparent" Foreground="#FF4444" Cursor="Hand" Click="Clear_Click" Style="{StaticResource ActionBtnStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>