<UserControl x:Class="HTPC.UI.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F0F0F" Foreground="White"
             Focusable="True">

    <UserControl.Resources>
        <Style x:Key="ListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TvGuideFocusStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderThickness="2" BorderBrush="White" CornerRadius="6" Margin="-2">
                            <Border.Effect>
                                <DropShadowEffect Color="White" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
		
		<Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="4,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="#00A4EF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#222222"/>
                                <Setter Property="Foreground" Value="#00A4EF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

       <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource TvGuideFocusStyle}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Grid.Column="2" Focusable="false" 
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="MainBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,15,0" Fill="#AAAAAA" Data="M 0 0 L 5 5 L 10 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MainBorder" Property="Background" Value="#1A1A1A"/>
                                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#333333"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="15,10,35,10" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextElement.Foreground="White"/>
                            
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Background="#1A1A1A" BorderThickness="1" BorderBrush="#333333" CornerRadius="8" Margin="0,5,0,0" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="0,5" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
		<Style x:Key="NavPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#B3B3B3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#444444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavPillActiveStyle" TargetType="Button" BasedOn="{StaticResource NavPillStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Focusable" Value="False"/> 
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,40,0,0" FocusManager.IsFocusScope="True" 
          KeyboardNavigation.DirectionalNavigation="Continue" 
          KeyboardNavigation.TabNavigation="Cycle">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="*"/>   
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="40,0,0,30" KeyboardNavigation.DirectionalNavigation="Continue">
            <Button Content="Home" Click="Home_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Guide" Style="{StaticResource NavPillActiveStyle}"/>
            <Button Content="Movies" Click="Movies_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Shows" Click="Shows_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Videos" Click="Videos_Click" Style="{StaticResource NavPillStyle}"/>
            <Button Content="Settings" Click="Settings_Click" Style="{StaticResource NavPillStyle}"/>
            <CheckBox x:Name="ShowHiddenCheckBox" Content="👁 Show Hidden Channels" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="20,0,0,0" Click="ShowHidden_Click"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="40,0,40,5" KeyboardNavigation.DirectionalNavigation="Continue">
            <Grid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#1A1A1A"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#333333"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="RepeatButton">
                    <Setter Property="Background" Value="#1A1A1A"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RepeatButton">
                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#333333"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
           <ComboBox x:Name="CollectionDropdown" Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,15,5" 
                      FontSize="16" FontWeight="Bold" SelectionChanged="CollectionDropdown_SelectionChanged" 
                      PreviewKeyDown="Dropdown_PreviewKeyDown" Style="{StaticResource DarkComboBoxStyle}">
            </ComboBox>
            
            <Grid Grid.Column="1" Margin="0,0,0,5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" KeyboardNavigation.DirectionalNavigation="Continue">
                    <Button Content="◀ Earlier" Width="100" Height="34" Margin="0,0,10,0" Click="ScrollLeft_Click" FocusVisualStyle="{StaticResource TvGuideFocusStyle}" PreviewKeyDown="GuideNav_PreviewKeyDown"/>
                    <Button Content="Later ▶" Width="100" Height="34" Click="ScrollRight_Click" FocusVisualStyle="{StaticResource TvGuideFocusStyle}" PreviewKeyDown="GuideNav_PreviewKeyDown"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" KeyboardNavigation.DirectionalNavigation="Continue">
                    <RepeatButton Content="▲ Up" Width="100" Height="34" Margin="0,0,10,0" Click="PageUp_Click" FocusVisualStyle="{StaticResource TvGuideFocusStyle}" PreviewKeyDown="GuideNav_PreviewKeyDown"/>
                    <RepeatButton Content="Down ▼" Width="100" Height="34" Click="PageDown_Click" FocusVisualStyle="{StaticResource TvGuideFocusStyle}" PreviewKeyDown="GuideNav_PreviewKeyDown"/>
                </StackPanel>
            </Grid>
        </Grid>
        
        <Grid Grid.Row="2" Margin="40,0,40,0" KeyboardNavigation.DirectionalNavigation="Continue">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="ChannelHeaderSpace" Grid.Row="0" Height="35" Margin="0,0,0,5" Background="Transparent"/>
                
                <ListBox x:Name="ChannelItemsControl" Grid.Row="1" Focusable="False" IsTabStop="False"
                         PreviewMouseWheel="ChannelItemsControl_PreviewMouseWheel" 
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ListBoxItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Height="70" Background="#1A1A1A" CornerRadius="8" Margin="0,5,15,5" Padding="10,5">
                                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Hide / Unhide Channel" Click="HideChannel_Click" FontSize="14" Padding="5"/>
                    <Separator/>
                        <MenuItem Header="Move Channel Up (↑)" Click="MoveChannelUp_Click" FontSize="14" Padding="5"/>
                        <MenuItem Header="Move Channel Down (↓)" Click="MoveChannelDown_Click" FontSize="14" Padding="5"/>
                        <MenuItem Header="Move to Top" Click="MoveChannelTop_Click" FontSize="14" Padding="5"/>
                        <MenuItem Header="Move to Bottom" Click="MoveChannelBottom_Click" FontSize="14" Padding="5"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                        
                                        <Button Click="FavoriteToggle_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Foreground="#D32F2F" FontSize="18" Cursor="Hand" Margin="0,0,5,0" FocusVisualStyle="{x:Null}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content" Value="♡"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Favorite}" Value="True">
                                                            <Setter Property="Content" Value="♥"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
                                        <Image Source="{Binding ImageUrl}" Height="28" Stretch="Uniform" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <TextBlock Grid.Row="1" Text="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <ScrollViewer Grid.Column="1" x:Name="TimelineScroller" PreviewMouseWheel="TimelineScroller_PreviewMouseWheel" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" IsTabStop="False">
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ItemsControl x:Name="TimeHeadersControl" Grid.Row="0" Height="35" Margin="0,0,0,5" Background="Transparent">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="240" BorderBrush="#333333" BorderThickness="2,0,0,0" Padding="10,0,0,5">
                                    <TextBlock Text="{Binding}" Foreground="#AAAAAA" FontSize="15" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ListBox x:Name="GuideItemsControl" Grid.Row="1" Focusable="False" IsTabStop="False" KeyboardNavigation.DirectionalNavigation="Continue"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent" BorderThickness="0" ScrollViewer.ScrollChanged="GuideItemsControl_ScrollChanged"
                             ItemContainerStyle="{StaticResource ListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="70" Margin="0,5" ClipToBounds="False">
                                    <ItemsControl ItemsSource="{Binding CurrentAirings}" Focusable="False" IsTabStop="False" KeyboardNavigation.DirectionalNavigation="Continue">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0" KeyboardNavigation.DirectionalNavigation="Continue"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="AiringBlock_Click" GotFocus="AiringButton_GotFocus" FocusVisualStyle="{StaticResource TvGuideFocusStyle}" Margin="{Binding DynamicMargin}" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand" Tag="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="EpgBorder" MinWidth="150" Width="{Binding BlockWidth}" Height="70" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="1,0">
                                                                <Grid Margin="{Binding InnerContentMargin}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Width="4" Background="{Binding CategoryColor}" CornerRadius="2" Margin="0,0,10,0"/>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayTitle}" Foreground="White" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding DisplaySummary}" Foreground="#AAAAAA" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EpgBorder" Property="Background" Value="#333333"/></Trigger>
                                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="EpgBorder" Property="Background" Value="#444444"/></Trigger>
                                                                <DataTrigger Binding="{Binding IsAiringNow}" Value="True">
                                                                    <Setter TargetName="EpgBorder" Property="Background" Value="#1A3A5A"/>
                                                                    <Setter TargetName="EpgBorder" Property="BorderBrush" Value="#00A4EF"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border x:Name="ModalOverlay" Grid.RowSpan="3" Background="#F20A0A0A" Visibility="Collapsed" VerticalAlignment="Bottom" Height="300" Padding="40" CornerRadius="24,24,0,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
            </Border.Effect>
            <Grid KeyboardNavigation.DirectionalNavigation="Continue">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="*"/> <ColumnDefinition Width="Auto"/> 
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="160" Height="220" CornerRadius="12" ClipToBounds="True" Background="#1A1A1A" Margin="0,0,30,0">
                    <Image x:Name="ModalImage" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,30,0">
                    <TextBlock x:Name="ModalTitle" Text="Show Title" FontSize="28" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ModalTime" Text="12:00 PM - 1:00 PM" FontSize="16" FontWeight="SemiBold" Foreground="#00A4EF" Margin="0,0,0,15"/>
                    <TextBlock x:Name="ModalSummary" FontSize="15" Foreground="#AAAAAA" TextWrapping="Wrap" LineHeight="22" MaxHeight="100" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" KeyboardNavigation.DirectionalNavigation="Continue">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>

                    <Button x:Name="RecordEpisodeButton" Content="⏺ Record" Width="160" Height="40" Background="#8B0000" Foreground="White" FontWeight="Bold" FontSize="16" BorderThickness="0" Margin="0,0,0,15" Cursor="Hand" Click="RecordEpisode_Click" FocusVisualStyle="{StaticResource TvGuideFocusStyle}" Visibility="Collapsed"/>
                    <Button x:Name="RecordSeriesButton" Content="⏺ Series Pass" Width="160" Height="40" Background="#A50000" Foreground="White" FontWeight="Bold" FontSize="16" BorderThickness="0" Margin="0,0,0,15" Cursor="Hand" Click="RecordSeries_Click" FocusVisualStyle="{StaticResource TvGuideFocusStyle}" Visibility="Collapsed"/>
                    <Button x:Name="WatchLiveBtn" Content="▶ Watch Live" Width="160" Height="40" Background="White" Foreground="Black" FontWeight="Bold" FontSize="16" BorderThickness="0" Margin="0,0,0,15" Cursor="Hand" Click="WatchButton_Click" FocusVisualStyle="{StaticResource TvGuideFocusStyle}"/>
                    <Button Content="Close" Width="160" Height="40" Background="#333333" Foreground="White" FontWeight="SemiBold" FontSize="16" BorderThickness="0" Cursor="Hand" Click="CloseModal_Click" FocusVisualStyle="{StaticResource TvGuideFocusStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>