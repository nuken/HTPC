<Window x:Class="HTPC.UI.Windows.PlayerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Player UI" Background="#01000000" AllowsTransparency="True" WindowStyle="None" 
        WindowState="Maximized" ShowInTaskbar="False" 
        MouseMove="Window_MouseMove" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#00A4EF"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="#00A4EF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniGuideItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="12" Padding="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="White"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="#88FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        
        <Grid x:Name="ControlsContainer">
            
            <Border x:Name="TopBar" VerticalAlignment="Top" Background="#CC0F0F0F" Padding="20" CornerRadius="0,0,16,16" Margin="40,0,40,0" Height="80">
                <Grid>
                    <Button Content="🔙" HorizontalAlignment="Left" Style="{StaticResource TransportButtonStyle}" Click="Back_Click" FontSize="28"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="ShowTitleText" Text="" Foreground="#AAAAAA" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="MediaTitleText" Text="Loading..." Foreground="White" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="MiniGuideContainer" VerticalAlignment="Bottom" Background="#F20A0A0A" Padding="30" CornerRadius="20,20,0,0" Margin="40,0,40,0" Height="300" Visibility="Collapsed">
                <Border.Effect><DropShadowEffect Color="Black" Direction="90" ShadowDepth="4" BlurRadius="20" Opacity="0.8"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,0,0,20">
                        <TextBlock Text="LIVE TV" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="Press Down arrow to hide" Foreground="#888888" FontSize="14" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ListBox x:Name="MiniGuideList" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource MiniGuideItemStyle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="280" Background="#1A1A1A" CornerRadius="12" Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                            <TextBlock Text="{Binding Number}" Foreground="White" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                            <Image Source="{Binding ImageUrl}" Height="28" Stretch="Uniform" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <TextBlock Grid.Row="1" Text="{Binding CurrentAirings[0].DisplayTitle, FallbackValue='Unknown Program'}" 
                                                   Foreground="White" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                                   
                                        <TextBlock Grid.Row="2" Text="{Binding CurrentAirings[0].DisplaySummary, FallbackValue=''}" 
                                                   Foreground="#AAAAAA" FontSize="14" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="65" Margin="0,10,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border x:Name="BottomBar" VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="30,20" CornerRadius="16,16,0,0" Margin="40,0,40,0" Height="120">
                <Border.Effect><DropShadowEffect Color="Black" Direction="90" ShadowDepth="4" BlurRadius="12" Opacity="0.5"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="TimelineGrid" Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Text="00:00:00" Foreground="White" FontSize="14" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <Slider x:Name="TimelineSlider" Grid.Column="1" VerticalAlignment="Center" Cursor="Hand" Minimum="0" Maximum="100" Value="0" IsMoveToPointEnabled="True" Thumb.DragStarted="Timeline_DragStarted" Thumb.DragCompleted="Timeline_DragCompleted"/>
                        <TextBlock x:Name="RemainingTimeText" Grid.Column="2" Text="-00:00:00" Foreground="#AAAAAA" FontSize="14" Margin="15,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="⏮" Style="{StaticResource TransportButtonStyle}" ToolTip="-10 Seconds" Click="SkipBackward_Click"/>
                        <Button x:Name="PlayPauseButton" Content="⏸" Style="{StaticResource TransportButtonStyle}" FontSize="36" Margin="20,0" Click="PlayPause_Click"/>
                        <Button Content="⏭" Style="{StaticResource TransportButtonStyle}" ToolTip="+30 Seconds" Click="SkipForward_Click"/>
                        <Button x:Name="CcButton" Content="CC" Style="{StaticResource TransportButtonStyle}" FontSize="20" ToolTip="Toggle Subtitles" Margin="30,0,0,0" Click="CC_Click"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="40,0,0,0">
                            <TextBlock Text="🔊" Foreground="White" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" Cursor="Hand" ValueChanged="VolumeSlider_ValueChanged"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
        <Border x:Name="BufferingOverlay" Background="#0F0F0F" Panel.ZIndex="2000" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📡" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="Tuning Channel..." FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Buffering live stream..." FontSize="16" Foreground="#B3B3B3" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>