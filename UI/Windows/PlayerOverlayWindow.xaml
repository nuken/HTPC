<Window x:Class="HTPC.UI.Windows.PlayerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Player UI" Background="#01000000" AllowsTransparency="True" WindowStyle="None" 
        ResizeMode="NoResize"
        ShowInTaskbar="False" 
        MouseMove="Window_MouseMove" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
    <Trigger Property="IsKeyboardFocused" Value="False">
        <Setter TargetName="bg" Property="Background" Value="Transparent"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Trigger>

    <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
        <Setter Property="Foreground" Value="#dce1e3"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#00A4EF" Opacity="0.8"/>
            </Setter.Value>
        </Setter>
    </Trigger>

    <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="#00A4EF"/>
    </Trigger>
</ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
		
		<Style x:Key="SliderFocusGlowStyle" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            
            <Setter Property="Background" Value="#01000000"/> 
            
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#00A4EF" Opacity="1.0"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#8800A4EF" Opacity="0.8"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
		

        <Style x:Key="MiniGuideItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,20,0"/> <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="FocusRing" BorderThickness="4" BorderBrush="Transparent" CornerRadius="12" Padding="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="#00A4EF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="#88FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        
        <Border x:Name="StatsForNerdsContainer" Background="#CC0A0A0A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Padding="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,100,0,0" Visibility="Collapsed" Panel.ZIndex="2000">
            <StackPanel>
                <TextBlock Text="Stats for nerds" Foreground="White" FontWeight="Bold" FontSize="18" Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Video Codec:" Foreground="#AAAAAA" Margin="0,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StatVideoCodec" Foreground="White" FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Resolution:" Foreground="#AAAAAA" Margin="0,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StatResolution" Foreground="White" FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Frame Rate:" Foreground="#AAAAAA" Margin="0,2"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="StatFps" Foreground="White" FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Audio Codec:" Foreground="#AAAAAA" Margin="0,2"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="StatAudioCodec" Foreground="White" FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="A/V Sync:" Foreground="#AAAAAA" Margin="0,2"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="StatAvSync" Foreground="White" FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Dropped Frames:" Foreground="#AAAAAA" Margin="0,2"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="StatDropped" Foreground="White" FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Hardware Dec:" Foreground="#AAAAAA" Margin="0,2"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="StatHwDec" Foreground="White" FontWeight="SemiBold"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid x:Name="ControlsContainer">
            
            <Border x:Name="TopBar" VerticalAlignment="Top" Background="#CC0F0F0F" Padding="20" CornerRadius="0,0,16,16" Margin="40,0,40,0" Height="80">
                <Grid>
                    <Button Content="🔙" HorizontalAlignment="Left" Style="{StaticResource TransportButtonStyle}" Click="Back_Click" FontSize="28"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="ShowTitleText" Text="" Foreground="#AAAAAA" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="MediaTitleText" Text="Loading..." Foreground="White" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <Border x:Name="MiniGuideContainer" VerticalAlignment="Bottom" Background="#F20A0A0A" Padding="30" CornerRadius="20,20,0,0" Margin="40,0,40,0" Height="300" Visibility="Collapsed">
                <Border.Effect><DropShadowEffect Color="Black" Direction="90" ShadowDepth="4" BlurRadius="20" Opacity="0.8"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,0,0,20">
                        <TextBlock Text="LIVE TV" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="Press Down arrow to hide" Foreground="#888888" FontSize="14" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ListBox x:Name="MiniGuideList" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource MiniGuideItemStyle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="280" Background="#1A1A1A" CornerRadius="12" Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                            <TextBlock Text="{Binding Number}" Foreground="White" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                            <Image Source="{Binding ImageUrl}" Height="28" Stretch="Uniform" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <TextBlock Grid.Row="1" Text="{Binding CurrentAirings[0].DisplayTitle, FallbackValue='Unknown Program'}" 
                                                   Foreground="White" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                                   
                                        <TextBlock Grid.Row="2" Text="{Binding CurrentAirings[0].DisplaySummary, FallbackValue=''}" 
                                                   Foreground="#AAAAAA" FontSize="14" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="65" Margin="0,10,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border x:Name="BottomBar" VerticalAlignment="Bottom" Background="#CC0F0F0F" Padding="30,20" CornerRadius="16,16,0,0" Margin="40,0,40,0" Height="120">
                <Border.Effect><DropShadowEffect Color="Black" Direction="90" ShadowDepth="4" BlurRadius="12" Opacity="0.5"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="SkipAdButton" Content="Skip Ad ⏭" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                            Margin="0,0,20,15" Padding="20,10" Background="#CC000000" Foreground="White" FontSize="18" 
                            FontWeight="Bold" BorderThickness="2" BorderBrush="#00A4EF" Cursor="Hand" 
                            Visibility="Collapsed" Click="SkipAdButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Grid x:Name="TimelineGrid" Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Text="00:00:00" Foreground="White" FontSize="14" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        
                        <Grid Grid.Column="1" VerticalAlignment="Center">
    <Canvas x:Name="CommercialMarkersCanvas" Height="10" Margin="5,0,5,0" IsHitTestVisible="False" VerticalAlignment="Center" ClipToBounds="True" SizeChanged="CommercialMarkersCanvas_SizeChanged"/>
    
    <Slider x:Name="TimelineSlider" Style="{StaticResource SliderFocusGlowStyle}" Cursor="Hand" Minimum="0" Maximum="100" Value="0" IsMoveToPointEnabled="True" Thumb.DragStarted="Timeline_DragStarted" Thumb.DragCompleted="Timeline_DragCompleted"/>
</Grid>
                        
                        <TextBlock x:Name="RemainingTimeText" Grid.Column="2" Text="-00:00:00" Foreground="#AAAAAA" FontSize="14" Margin="15,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                   <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        
                        <Button Content="⏪" Style="{StaticResource TransportButtonStyle}" Click="Restart_Click"/>

                        <Button Content="⏮" Style="{StaticResource TransportButtonStyle}" 
                                PreviewMouseLeftButtonDown="SkipBackward_MouseDown" 
                                PreviewMouseLeftButtonUp="Skip_MouseUp" 
                                MouseLeave="Skip_MouseUp" />
                                
                        <Button x:Name="PlayPauseButton" Content="⏸" Style="{StaticResource TransportButtonStyle}" Margin="20,0" Click="PlayPause_Click"/>
                        
                        <Button Content="⏭" Style="{StaticResource TransportButtonStyle}"
                                PreviewMouseLeftButtonDown="SkipForward_MouseDown" 
                                PreviewMouseLeftButtonUp="Skip_MouseUp" 
                                MouseLeave="Skip_MouseUp" />
                        
                        <StackPanel Orientation="Horizontal" Margin="30,0,0,0">
                            <Button x:Name="AnimeButton" Content="✨" Style="{StaticResource TransportButtonStyle}" FontSize="24" Margin="0,0,15,0" Click="Anime_Click" Visibility="Collapsed"/>
                            <Button x:Name="CcButton" Content="CC" Style="{StaticResource TransportButtonStyle}" FontSize="20" Margin="0,0,15,0" Click="CC_Click"/>
                            <Button x:Name="StatsButton" Content="📊" Style="{StaticResource TransportButtonStyle}" FontSize="20" Click="StatsButton_Click"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="40,0,0,0">
                            <TextBlock Text="🔊" Foreground="White" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider x:Name="VolumeSlider" Style="{StaticResource SliderFocusGlowStyle}" Width="120" Minimum="0" Maximum="100" Value="100" 
        SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True"
        VerticalAlignment="Center" Cursor="Hand" ValueChanged="VolumeSlider_ValueChanged"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            
            <Border x:Name="UpNextPromptContainer" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,140" Visibility="Collapsed">
                <Button x:Name="UpNextButton" Cursor="Hand" Click="UpNextButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#E61E1E1E" BorderBrush="#00A4EF" BorderThickness="2" CornerRadius="12" Padding="20">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#333333"/>
                                    <Setter TargetName="bg" Property="BorderBrush" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#333333"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    
                    <StackPanel>
                        <TextBlock Text="UP NEXT" Foreground="#00A4EF" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock x:Name="UpNextTitleText" Text="Next Episode Title" Foreground="White" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="300"/>
                        <TextBlock Text="Press OK to play" Foreground="#AAAAAA" FontSize="14" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>
            </Border>

        </Grid>
        <Border x:Name="BufferingOverlay" Background="#0F0F0F" Panel.ZIndex="2000" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📡" FontSize="60"  Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="Tuning Channel..." FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Buffering live stream..." FontSize="16" Foreground="#B3B3B3" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>