<Window x:Class="HTPC.UI.Windows.MultiviewPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HTPC.UI.Controls"
        Title="Multiview" Background="Black" WindowStyle="None" WindowState="Maximized"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#00A4EF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="LayoutRoot">
        
        <Grid x:Name="PlayerGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="Col0" Width="*"/>
                <ColumnDefinition x:Name="Col1" Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="Row0" Height="*"/>
                <RowDefinition x:Name="Row1" Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="Border0" BorderThickness="4" BorderBrush="Transparent" CornerRadius="4">
                <controls:MpvVideoHost x:Name="View0" />
            </Border>
            
            <Border x:Name="Border1" BorderThickness="4" BorderBrush="Transparent" CornerRadius="4">
                <controls:MpvVideoHost x:Name="View1" />
            </Border>
            
            <Border x:Name="Border2" BorderThickness="4" BorderBrush="Transparent" CornerRadius="4">
                <controls:MpvVideoHost x:Name="View2" />
            </Border>
            
            <Border x:Name="Border3" BorderThickness="4" BorderBrush="Transparent" CornerRadius="4">
                <controls:MpvVideoHost x:Name="View3" />
            </Border>
        </Grid>

        <Popup x:Name="OverlayPopup" IsOpen="True" AllowsTransparency="True" Placement="Center" PlacementTarget="{Binding ElementName=LayoutRoot}" Focusable="False">
            
            <Grid x:Name="PopupRoot" Background="#01000000" MouseMove="Overlay_MouseMove" MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
                
                <Grid x:Name="ControlsContainer">
                    <Border x:Name="TopBar" VerticalAlignment="Top" Background="#CC0F0F0F" Padding="20" CornerRadius="0,0,16,16" Margin="40,0,40,0" Height="100">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.5"/>
                        </Border.Effect>
                        <Grid>
                            <Button Content="🔙" HorizontalAlignment="Left" Style="{StaticResource TransportButtonStyle}" Click="Back_Click" FontSize="28"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="MULTIVIEW" Foreground="White" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Press L to change layout • Click screen to switch audio" Foreground="#AAAAAA" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Popup>
    </Grid>
</Window>