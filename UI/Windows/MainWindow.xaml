<Window x:Class="HTPC.UI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nucleus HTPC" Height="720" Width="1280"
		Background="#0F0F0F" Foreground="White"
        WindowStyle="None" AllowsTransparency="True" WindowState="Maximized"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="45"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C42B1C"/> <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" x:Name="TitleBarRow"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Background="#1A1A1A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Nucleus HTPC" Foreground="#888888" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold" FontSize="12"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="—" Style="{StaticResource TitleBarButtonStyle}" Click="Minimize_Click" FontSize="14" FontWeight="Bold"/>
                <Button x:Name="MaximizeRestoreBtn" Content="🗗" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeRestore_Click" FontSize="14"/>
                <Button Content="✕" Style="{StaticResource TitleBarCloseStyle}" Click="Close_Click" FontSize="14"/>
            </StackPanel>
        </Grid>

        <ContentControl x:Name="MainShellContainer" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- FLOATING FULLSCREEN CLOSE BUTTON -->
        <Button x:Name="FullscreenCloseBtn" 
		        Grid.RowSpan="2"
                Content="EXIT" 
                FontSize="16" FontWeight="Bold"
                Width="45" Height="45"
                HorizontalAlignment="Right" VerticalAlignment="Top" 
                Background="#D32F2F" Foreground="White" 
                BorderThickness="2" BorderBrush="Transparent" Margin="0,15,15,0"
                Cursor="Hand" Click="AppExit_Click"
                Panel.ZIndex="9999" Visibility="Collapsed" Focusable="True">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Mouse Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#FF0000"/>
                        </Trigger>
                        <!-- Remote Control Focus State -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#FF0000"/>
                            <Setter TargetName="bg" Property="BorderBrush" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

   </Grid>
</Window>